{
  "$schema": "../../schemas/page.v1.json",
  "v": 1,
  "id": "dashboard",
  "template": "dashboard",
  "source": {
    "store": "alerts",
    "fields": {
      "customer": { "label": "Customer", "select": "multiple", "icon": "buildings" },
      "region": {
        "label": "Region", "select": "multiple", "icon": "globe",
        "labels": { "AMER": "Americas", "LATAM": "Latin America" }
      },
      "category": { "label": "Category", "select": "multiple" },
      "os": { "label": "OS", "select": "multiple" },
      "severity": { "label": "Severity", "select": "multiple" }
    },
    "scopes": {
      "view": { "label": "View filters", "holds": ["customer", "region"] }
    }
  }
}
