{
  "$schema": "../../schemas/page.v1.json",
  "v": 1,
  "id": "records",
  "source": {
    "store": "customers",
    "pageSize": 25,
    "search": ["name", "email", "owner"],
    "fields": {
      "name": { "label": "Name", "advanced": "only", "op": "contains" },
      "email": { "label": "Email", "advanced": "only", "op": "contains" },
      "customer": { "label": "Customer", "select": "multiple", "icon": "buildings" },
      "status": { "label": "Status", "select": "multiple" },
      "plan": { "label": "Plan", "select": "multiple" },
      "tier": { "label": "Tier", "select": "multiple" },
      "region": {
        "label": "Region", "select": "multiple", "icon": "globe",
        "labels": { "AMER": "Americas", "LATAM": "Latin America" }
      },
      "owner": { "label": "Owner", "select": "multiple", "advanced": true },
      "seats": { "label": "Seats", "type": "number", "advanced": true },
      "spend": { "label": "Spend", "type": "number", "advanced": true },
      "openTickets": { "label": "Tickets", "type": "number", "advanced": true },
      "health": {
        "label": "Health", "type": "number", "advanced": true,
        "thresholds": [
          { "to": 60, "label": "At risk", "status": "critical" },
          { "to": 80, "label": "Watch", "status": "warning" },
          { "to": 100, "label": "Healthy", "status": "success" }
        ]
      },
      "created": { "label": "Date", "type": "date", "icon": "calendar" },
      "lastSeen": { "label": "Last seen", "type": "date" }
    },
    "scopes": {
      "view": { "label": "View filters", "holds": ["customer", "region", "created"],
                "sets": [{ "id": "account", "label": "Account", "mode": "serial", "fields": ["customer", "region"] }] },
      "data": {
        "label": "Customer records", "offers": "all",
        "holds": ["status", "plan", "tier", "owner"]
      }
    }
  },
  "savedFilters": {
    "has-tickets": { "label": "Has open tickets", "query": { "v": 1, "scopes": { "data": { "where": { "openTickets": { "gt": 0 } } } } } },
    "at-risk": { "label": "At risk", "query": { "v": 1, "scopes": { "data": { "where": { "health": { "band": "At risk" } } } } } },
    "unassigned": { "label": "Unassigned", "query": { "v": 1, "scopes": { "data": { "where": { "owner": { "eq": "Unassigned" } } } } } }
  },
  "ui": {
    "grid": {
      "key": "email",
      "columns": [
        { "field": "name",        "header": "Name",      "sortable": true, "advanced": "only", "op": "contains" },
        { "field": "email",       "header": "Email",     "sortable": true, "advanced": "only", "op": "contains" },
        { "field": "customer",    "header": "Customer",  "sortable": true },
        { "field": "status",      "header": "Status",    "sortable": true },
        { "field": "plan",        "header": "Plan",      "sortable": true },
        { "field": "tier",        "header": "Tier",      "sortable": true },
        { "field": "region",      "header": "Region",    "sortable": true },
        { "field": "owner",       "header": "Owner",     "sortable": true },
        { "field": "seats",       "header": "Seats",     "sortable": true, "type": "number" },
        { "field": "spend",       "header": "Spend",     "sortable": true, "type": "number" },
        { "field": "openTickets", "header": "Tickets",   "sortable": true, "type": "number" },
        { "field": "health",      "header": "Health",    "sortable": true, "type": "number" },
        { "field": "created",     "header": "Created",   "sortable": true, "type": "date" },
        { "field": "lastSeen",    "header": "Last seen", "sortable": true, "type": "date" }
      ],
      "actions": [
        { "id": "edit", "label": "Edit", "icon": "pencil" },
        { "id": "delete", "label": "Delete", "icon": "trash", "multi": true, "danger": true }
      ]
    }
  }
}
