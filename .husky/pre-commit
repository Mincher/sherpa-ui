#!/bin/sh
# Run type-check to prevent commits with TypeScript errors
echo "🔍 Running TypeScript type-check..."
npm run type-check
TYPE_CHECK_RESULT=$?

if [ $TYPE_CHECK_RESULT -ne 0 ]; then
  echo "❌ Type-check failed. Commit blocked."
  exit 1
fi

# The component specs are the contract the MCP and every agent reads. Nothing
# validated them until 2026-09-16, and they had rotted badly: 31 of 58 declared
# events their component never emits, because the generator was scraping English
# prose for identifiers. Cheap to check, and the only thing standing between a
# fixed spec and the next silent drift.
#
# `spec:check` (not `spec:validate`) — it does BOTH halves:
#   validate   the spec matches schemas/component.v1.json
#   round-trip the spec regenerates the source it came from
# The round-trip is the half that catches a spec which is well-formed but no
# longer describes its component. It had been reported and never enforced, so 22
# of 58 failed it for a whole branch with every commit passing. 418ms for all 58.
echo "📋 Checking component specs (schema + round-trip)..."
# QUIET ON SUCCESS. A 58-row table on every commit is noise that trains people to
# scroll past the one line that matters. The output is captured and printed only
# when something fails.
SPEC_OUT=$(npm run spec:check --silent 2>&1)
SPEC_RESULT=$?

if [ $SPEC_RESULT -ne 0 ]; then
  echo "$SPEC_OUT" | grep -vE '^sherpa-[a-z-]+ +PASS +PASS'
  echo "❌ A component spec is invalid or no longer round-trips. Commit blocked."
  echo "   See the details above, then regenerate: node scripts/generate-component-spec.mjs <name>"
  echo "   A round-trip failure usually means the SOURCE changed and the spec did not."
  exit 1
fi

# docs/TRAPS.md holds the facts that cost hours, moved out of the source so the
# code reads as code. A comment cannot lie about the line beneath it; a doc can.
# This is the gate that makes moving them safe — it fails on a dangling pointer,
# an orphaned entry, or a Site list that no longer matches who cites it.
#
# Without it this would be the round-trip check all over again: reported for
# three months, enforced never, 22 of 58 failing the whole time.
echo "🪤 Checking docs/TRAPS.md against the code..."
TRAPS_OUT=$(npm run check:traps --silent 2>&1)
TRAPS_RESULT=$?

if [ $TRAPS_RESULT -ne 0 ]; then
  echo "$TRAPS_OUT"
  echo "❌ A trap and its citation have drifted. Commit blocked."
  exit 1
fi

# An MCP tool module's header lists the tools it provides, and that list is what
# a person reads before the code. One of them was wrong for two days: discover.js
# promised `explain_token` and `browse_ontology`, deleted with the ontology, and
# omitted `find_token`, which replaced them. Nothing noticed because nothing
# looked — the same shape as the spec round-trip failure, so it gets the same
# treatment: a gate that RUNS.
echo "🔧 Checking MCP tool headers against their registrations..."
MCP_OUT=$(npm run check:mcp --silent 2>&1)
MCP_RESULT=$?

if [ $MCP_RESULT -ne 0 ]; then
  echo "$MCP_OUT"
  echo "❌ An MCP tool header and its registrations have drifted. Commit blocked."
  exit 1
fi

# ONE OWNER PER VALUE. The DataSource writes seven `data-*` attributes onto
# every component it binds; a component that writes one too is both reporter and
# owner of the same value. That is the recurring bug this repo hit four times in
# a week — a grid deleting a sort column the toolbar was suspending, a pager
# showing a page the query had not reached.
#
# `data-locked` is the answer, and it was DOCUMENTED while being honoured by one
# component of 58, for months. A hand audit found three violations; this gate
# immediately found a fourth the audit had missed.
echo "🔒 Checking one owner per value..."
OWN_OUT=$(npm run check:ownership --silent 2>&1)
OWN_RESULT=$?

if [ $OWN_RESULT -ne 0 ]; then
  echo "$OWN_OUT"
  echo "❌ A component writes a value the DataSource owns. Commit blocked."
  exit 1
fi

# ONE DECLARATION PER ATTRIBUTE. A `:host([data-x])` rule is a public API: a
# host sets the attribute and the component restyles. Undeclared, it is a
# contract between the CSS and nothing — invisible to the TS, to the generated
# spec, and to an agent reading either.
#
# 65 of them were in exactly that state across 31 components, found the moment
# anything looked. Declaring them changed no behaviour (kind:style writes
# nothing) and 576 tests stayed green, which is the point: the gap was never
# visible as a bug.
echo "🏷️  Checking every :host([data-*]) is declared..."
PROPS_OUT=$(npm run check:props --silent 2>&1)
PROPS_RESULT=$?

if [ $PROPS_RESULT -ne 0 ]; then
  echo "$PROPS_OUT"
  echo "❌ A host attribute is styled but not declared. Commit blocked."
  exit 1
fi

# The component CSS rules PRINCIPLES.md lists as gated — including a state colour
# that reads the Theme "active" ramp instead of the Style mode, which is how a
# Figma change to Style stopped reaching the filter chip.
echo "🎨 Linting component CSS..."
CSS_OUT=$(npm run lint:css --silent 2>&1)
CSS_RESULT=$?

if [ $CSS_RESULT -ne 0 ]; then
  echo "$CSS_OUT" | grep -E '^(ERROR|warn)'
  echo "❌ Component CSS breaks a gated rule. Commit blocked."
  exit 1
fi

# A doc that names a script or command must name one that EXISTS. Found four
# dangling pointers the moment it was written, two of which read as live
# instructions — including a note saying two scripts "were KEPT" that had since
# been deleted.
echo "📚 Checking docs name real scripts and commands..."
DOCS_OUT=$(npm run check:docs --silent 2>&1)
DOCS_RESULT=$?

if [ $DOCS_RESULT -ne 0 ]; then
  echo "$DOCS_OUT"
  echo "❌ A doc points at something that does not exist. Commit blocked."
  exit 1
fi

# EVERY FILE SAYS WHAT IT HOLDS. A file's header ends in a `Map:` of its
# exports — the higher-plane map `npm run map` prints. `--staged`: a file this
# commit touches must carry its map, so updating it is the last step of any
# change. TRAP T-a-file-says-what-it-holds
echo "🗺️  Checking every changed file carries its map..."
MAP_OUT=$(npm run check:map --silent -- --staged 2>&1)
MAP_RESULT=$?

if [ $MAP_RESULT -ne 0 ]; then
  echo "$MAP_OUT"
  echo "❌ A file's Map does not match what it exports. Run npm run map:write <file>. Commit blocked."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
