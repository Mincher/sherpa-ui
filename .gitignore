# alias-snapshot.json IS tracked — legacy; superseded by token-overrides.json.
figma-tokens/figma-variables.json
figma-tokens/figma-variables.prev.json
figma-tokens/figma-variables.staged.json
figma-tokens/Apex*/
figma-tokens/Classic/

