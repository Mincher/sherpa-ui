{
  "$schema": "../schemas/pattern.v1.json",
  "v": 1,
  "id": "records-list",
  "label": "Find and act on records",
  "use": "Many rows of one kind, which a reader narrows, sorts and changes: Add opens the form, a row's Edit opens it filled, and its Delete asks first. The Context's module saves the form through the store (insert, update, remove) and says what each save did in a toast: SherpaToast.success, or SherpaToast.critical when the store refuses it.",
  "when": { "task": { "in": ["browse", "find", "triage", "manage", "edit"] }, "writes": { "eq": true } },
  "rank": 20,
  "layout": {
    "el": "sherpa-layout-grid",
    "attrs": { "data-rows": "fit", "data-row-count": "2" },
    "children": [
      { "role": "count", "el": "sherpa-metric",
        "attrs": { "data-col-span": "xsmall", "data-min-row-span": "1", "data-label": "Records", "data-aggregate": "count" } },
      { "role": "summary", "el": "sherpa-metric", "each": "numberField", "max": 3,
        "attrs": { "data-col-span": "xsmall", "data-min-row-span": "1", "data-label": "{label}", "data-aggregate": "sum", "data-field": "{field}" } },
      { "role": "records", "el": "sherpa-container",
        "attrs": { "data-scope": "data", "data-col-span": "full", "data-min-row-span": "2", "data-grow": true, "data-padding": "none", "data-padding-inline": "md", "data-fill": true },
        "children": [
          { "el": "sherpa-stack", "attrs": { "data-gap": "md", "data-grow": true, "data-fill": true }, "children": [
            { "role": "actions", "el": "sherpa-toolbar", "children": [
              { "role": "add", "el": "sherpa-button",
                "attrs": { "slot": "leading", "id": "add", "data-look": "saturated", "data-icon-start": "plus", "data-label": "Add", "commandfor": "record-dialog", "command": "--show" } }
            ] },
            { "role": "filters", "el": "sherpa-quick-filter-toolbar", "attrs": { "data-scope": "data", "data-saveable": true } },
            { "role": "rows", "el": "sherpa-data-grid", "attrs": { "id": "grid", "data-scope": "data", "data-grow": true, "data-selectable": true, "data-column-filters": true } }
          ] },
          { "role": "pager", "el": "sherpa-pagination", "attrs": { "slot": "footer" } }
        ] },
      { "role": "form", "el": "form", "attrs": { "id": "record-form", "style": "display: contents" }, "children": [
        { "el": "sherpa-dialog", "attrs": { "id": "record-dialog", "data-heading": "Add a record" }, "children": [
          { "el": "sherpa-stack", "children": [
            { "role": "inputs", "el": "sherpa-input-text", "each": "field", "attrs": { "name": "{field}", "data-label": "{label}" } }
          ] },
          { "el": "sherpa-container-footer", "attrs": { "slot": "footer" }, "children": [
            { "el": "sherpa-button", "attrs": { "id": "cancel", "data-label": "Cancel", "commandfor": "record-dialog", "command": "--hide" } },
            { "role": "save", "el": "sherpa-button", "attrs": { "id": "save", "data-look": "saturated", "data-label": "Save" } }
          ] }
        ] }
      ] },
      { "role": "confirm", "el": "sherpa-dialog", "attrs": { "id": "confirm", "data-heading": "Delete this record?" }, "children": [
        { "el": "sherpa-container-footer", "attrs": { "slot": "footer" }, "children": [
          { "el": "sherpa-button", "attrs": { "id": "confirm-cancel", "data-label": "Cancel", "commandfor": "confirm", "command": "--hide" } },
          { "role": "delete", "el": "sherpa-button",
            "attrs": { "id": "confirm-delete", "data-look": "saturated", "data-status": "critical", "data-icon-start": "trash", "data-label": "Delete" } }
        ] }
      ] }
    ]
  },
  "page": {
    "scopes": {
      "data": { "label": "Records", "offers": "all", "holds": ["{statusField}"] }
    },
    "ui": {
      "grid": {
        "actions": [
          { "id": "edit", "label": "Edit", "icon": "pencil" },
          { "id": "delete", "label": "Delete", "icon": "trash", "multi": true, "danger": true }
        ]
      }
    }
  },
  "states": ["loading", "empty", "no-matches", "unreached", "down"],
  "agent": { "may": ["summary", "inputs", "columns", "presets"], "keeps": ["filters", "rows", "pager", "add", "form", "save", "confirm"] }
}
