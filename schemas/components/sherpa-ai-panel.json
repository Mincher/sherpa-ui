{
  "tagName": "sherpa-ai-panel",
  "description": "Standalone chrome for AI / chat surfaces.",
  "category": "ai",
  "tier": 3,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-variant",
      "type": "enum",
      "description": "\"inline\" | \"overlay\" (default \"overlay\")"
    },
    {
      "name": "data-position",
      "type": "enum",
      "description": "\"left\" | \"right\"     (default \"right\")"
    },
    {
      "name": "data-expanded",
      "type": "boolean",
      "description": "Visible state."
    },
    {
      "name": "data-heading",
      "type": "string",
      "description": "Header title (default \"Ask AI\")."
    },
    {
      "name": "data-width",
      "type": "string",
      "description": "Custom width (CSS value)."
    },
    {
      "name": "data-can-archive",
      "type": "boolean",
      "description": "Enables archive button."
    },
    {
      "name": "data-busy",
      "type": "boolean",
      "description": "Disables new-chat + archive."
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "ai-panel-new-chat",
      "description": "Fired when the \"new chat\" button is clicked.",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "ai-panel-archive",
      "description": "Fired when the \"archive\" button is clicked.",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "panel-close",
      "description": "Fired when the close button is clicked.",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "panel-toggle",
      "description": "Fired when data-expanded changes.",
      "bubbles": true,
      "composed": true,
      "detail": null
    }
  ],
  "methods": [
    {
      "name": "open()",
      "description": "Set data-expanded."
    },
    {
      "name": "close()",
      "description": "Remove data-expanded (and dispatch panel-close)."
    },
    {
      "name": "toggle()",
      "description": "Toggle data-expanded."
    }
  ],
  "properties": [
    {
      "name": "expanded",
      "type": "boolean",
      "description": "Getter/setter for data-expanded."
    }
  ]
}
