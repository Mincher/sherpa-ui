{
  "tagName": "sherpa-ai-panel",
  "description": "Standalone chrome for AI / chat surfaces.",
  "category": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data",
      "type": "enum",
      "description": "variant     \"inline\" | \"overlay\" (default \"overlay\")"
    },
    {
      "name": "data",
      "type": "enum",
      "description": "position    \"left\" | \"right\"     (default \"right\")"
    },
    {
      "name": "data",
      "type": "flag",
      "description": "expanded    Visible state."
    },
    {
      "name": "data",
      "type": "string",
      "description": "heading     Header title (default \"Ask AI\")."
    },
    {
      "name": "data",
      "type": "string",
      "description": "width       Custom width (CSS value)."
    },
    {
      "name": "data-can",
      "type": "flag",
      "description": "archive Enables archive button."
    },
    {
      "name": "data",
      "type": "flag",
      "description": "busy        Disables new-chat + archive."
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "ai-panel-new-chat",
      "description": "Fired when the \"new chat\" button is clicked.",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "ai-panel-archive",
      "description": "Fired when the \"archive\" button is clicked.",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "panel-close",
      "description": "Fired when the close button is clicked.",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "panel-toggle",
      "description": "Fired when data-expanded changes.",
      "bubbles": true,
      "composed": true,
      "detail": null
    }
  ],
  "methods": [
    {
      "name": "open()",
      "description": "Set data-expanded."
    },
    {
      "name": "close()",
      "description": "Remove data-expanded (and dispatch panel-close)."
    },
    {
      "name": "toggle()",
      "description": "Toggle data-expanded."
    }
  ],
  "properties": [
    {
      "name": "expanded",
      "type": "boolean",
      "description": "Getter/setter for data-expanded."
    }
  ]
}
