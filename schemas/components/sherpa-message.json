{
  "tagName": "sherpa-message",
  "description": "Banner / inline message with status variants.",
  "category": "feedback",
  "tier": 4,
  "group": "feedback",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-status",
      "type": "enum",
      "description": "success | critical | warning | info | urgent",
      "enumValues": [
        "success",
        "critical",
        "warning",
        "info",
        "urgent"
      ]
    },
    {
      "name": "data-label",
      "type": "string",
      "description": "Message text"
    },
    {
      "name": "data-action-label",
      "type": "string",
      "description": "Inline action link text"
    },
    {
      "name": "data-action-href",
      "type": "string",
      "description": "Inline action link href"
    },
    {
      "name": "data-action-icon",
      "type": "string",
      "description": "FA classes for trailing link icon"
    },
    {
      "name": "data-dismissible",
      "type": "boolean",
      "description": "Show close button"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "close",
      "description": "",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "action",
      "description": "",
      "bubbles": true,
      "composed": true,
      "detail": {
        "href": "string"
      }
    }
  ],
  "methods": [
    {
      "name": "dismiss()",
      "description": "Dispatch close event and remove element"
    }
  ],
  "properties": [
    {
      "name": "status",
      "type": "string",
      "description": "Getter/setter for data-status"
    },
    {
      "name": "dismissible",
      "type": "boolean",
      "description": "Getter/setter for data-dismissible"
    }
  ]
}
