{
  "tagName": "sherpa-layout-grid",
  "description": "Responsive dashboard grid. Slotted <sherpa-container data-variant=\"resizable\"> children take grid spans from their data-col-span / data-row-span attributes.",
  "category": "shell",
  "tier": 1,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-row-height",
      "type": "string",
      "description": "CSS length for grid-auto-rows (default: 160px)"
    },
    {
      "name": "data-content",
      "type": "enum",
      "description": "\"static\" — opts out of grid; stacks children"
    },
    {
      "name": "data-editable",
      "type": "boolean",
      "description": "Enables drag-to-reposition for slotted containers"
    },
    {
      "name": "data-heading",
      "type": "string",
      "description": "Heading text shown on the grid header strip"
    },
    {
      "name": "data-export-title",
      "type": "string",
      "description": "Title used when exporting the grid (PDF / image)"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "sherpa-container children"
    }
  ],
  "events": [
    {
      "name": "layout-reorder",
      "description": "Fires after a successful reposition.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "from": "number",
        "to": "number",
        "order": "string[] }  // order is the"
      }
    }
  ],
  "cssProperties": [
    {
      "name": "--maxColCount",
      "description": "Integer column count (default 12, registered)"
    },
    {
      "name": "--row-height",
      "description": "Row height (default 160px, registered)"
    }
  ]
}
