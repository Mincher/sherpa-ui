{
  "tagName": "sherpa-input-checkbox-group",
  "description": "Group of checkboxes with shared label, description, helper, and an optional pre-stamped `weekdays` template.",
  "category": "input",
  "tier": 4,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "name",
      "type": "string",
      "description": "Group field name; cascaded to children"
    },
    {
      "name": "data-label",
      "type": "string",
      "description": "Group legend"
    },
    {
      "name": "data-description",
      "type": "string",
      "description": "Sub-label below the legend"
    },
    {
      "name": "data-helper",
      "type": "string",
      "description": "Helper text below the options"
    },
    {
      "name": "data-orientation",
      "type": "enum",
      "description": "vertical (default) | horizontal"
    },
    {
      "name": "data-options",
      "type": "json",
      "description": "[{value,label,description?,disabled?}]"
    },
    {
      "name": "data-value",
      "type": "json",
      "description": "Currently selected values, e.g. [\"1\",\"3\"]"
    },
    {
      "name": "data-status",
      "type": "enum",
      "description": "critical | warning | success | info | urgent",
      "enumValues": [
        "critical",
        "warning",
        "success",
        "info",
        "urgent"
      ]
    },
    {
      "name": "data-template",
      "type": "string",
      "description": "\"default\" (default) | \"weekdays\""
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Disable all children"
    },
    {
      "name": "required",
      "type": "boolean",
      "description": "At least one selection required"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "change",
      "description": "Selection changed.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "value": "string[]",
        "values": "string[]"
      }
    }
  ],
  "methods": [
    {
      "name": "getValue()",
      "description": "Returns the current value array."
    },
    {
      "name": "setValue(arr)",
      "description": "Replace the current value array.",
      "params": [
        {
          "name": "arr",
          "type": "any"
        }
      ]
    },
    {
      "name": "clear()",
      "description": "Uncheck every option."
    }
  ],
  "properties": [
    {
      "name": "value",
      "type": "string[]",
      "description": "Currently selected values (read/write)"
    }
  ]
}
