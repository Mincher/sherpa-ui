{
  "tagName": "sherpa-button",
  "description": "Multi-template button web component. Two templates (selected via data-type → get templateId()): default       — Standard button: icon(s) + label + badge icon          — Icon-only square button For compound button patterns (split, dismissable chip), compose separate sherpa-button elements inside a .grouped wrapper. The button is self-managing for its own visual state and broadcasts events so parent components (filter-bar, container) can orchestrate. Menu behaviour: Any button with data-menu=\"true\" acts as a menu trigger. If data-menu-template is set, stamps the matching template from SherpaMenu.getMenuTemplate(id) then dispatches menu-populate.",
  "category": "control",
  "tier": 4,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-type",
      "type": "enum",
      "description": "default | icon",
      "enumValues": [
        "default",
        "icon"
      ]
    },
    {
      "name": "data-label",
      "type": "string",
      "description": "Button text label"
    },
    {
      "name": "data-variant",
      "type": "enum",
      "description": "primary | secondary | tertiary | tertiary-on-color",
      "enumValues": [
        "primary",
        "secondary",
        "tertiary",
        "tertiary-on-color"
      ]
    },
    {
      "name": "data-size",
      "type": "enum",
      "description": "2x-small | x-small | small | base | large (default: base)",
      "enumValues": [
        "2x-small",
        "x-small",
        "small",
        "base",
        "large"
      ]
    },
    {
      "name": "data-active",
      "type": "boolean",
      "description": "Active/pressed toggle state"
    },
    {
      "name": "data-status",
      "type": "enum",
      "description": "critical | warning | success | info | urgent",
      "enumValues": [
        "critical",
        "warning",
        "success",
        "info",
        "urgent"
      ]
    },
    {
      "name": "data-icon-start",
      "type": "string",
      "description": "Leading icon (Font Awesome unicode)"
    },
    {
      "name": "data-icon-end",
      "type": "string",
      "description": "Trailing icon (Font Awesome unicode)"
    },
    {
      "name": "data-icon-weight",
      "type": "enum",
      "description": "fa-solid | fa-regular | fa-light",
      "enumValues": [
        "fa-solid",
        "fa-regular",
        "fa-light"
      ]
    },
    {
      "name": "data-count",
      "type": "number",
      "description": "Badge count"
    },
    {
      "name": "data-menu",
      "type": "boolean",
      "description": "Enable menu trigger on any button type"
    },
    {
      "name": "data-menu-position",
      "type": "enum",
      "description": "Menu placement (top | bottom | left | right)",
      "enumValues": [
        "top",
        "bottom",
        "left",
        "right"
      ]
    },
    {
      "name": "data-menu-template",
      "type": "string",
      "description": "Menu template id to stamp from SherpaMenu"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Native disabled state"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "button-click",
      "description": "Main button area clicked",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "menu-open",
      "description": "Menu is about to show",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "menu-close",
      "description": "Menu was dismissed",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "menu-select",
      "description": "Menu item selected",
      "bubbles": true,
      "composed": true,
      "detail": {
        "item": "Element",
        "action": "string"
      }
    },
    {
      "name": "menu-populate",
      "description": "Menu stamped and ready for dynamic items",
      "bubbles": true,
      "composed": true,
      "detail": {
        "menu": "SherpaMenu"
      }
    }
  ],
  "methods": [
    {
      "name": "setMenuItems(items, opts)",
      "description": "Populate menu with items array",
      "params": [
        {
          "name": "items",
          "type": "any"
        },
        {
          "name": "opts",
          "type": "any"
        }
      ]
    },
    {
      "name": "getSelectedValues()",
      "description": "Get checked menu item values"
    },
    {
      "name": "clearSelection()",
      "description": "Clear all checked menu items"
    }
  ],
  "properties": [
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Disabled state (read/write)"
    },
    {
      "name": "active",
      "type": "boolean",
      "description": "Active/pressed state (read/write)"
    },
    {
      "name": "label",
      "type": "string",
      "description": "Button text label (read/write)"
    },
    {
      "name": "templateId",
      "type": "string",
      "description": "Active template id (read-only)",
      "readonly": true
    },
    {
      "name": "menuElement",
      "type": "SherpaMenu",
      "description": "The menu instance (read-only)",
      "readonly": true
    }
  ]
}
