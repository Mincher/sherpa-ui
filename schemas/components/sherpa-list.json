{
  "tagName": "sherpa-list",
  "description": "Grouping container for sherpa-list-item children. Provides variant + density styling, an optional heading row with actions slot, and an automatic empty-state.",
  "category": "content",
  "tier": 3,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-variant",
      "type": "enum",
      "description": "default | bordered | divided",
      "default": "default",
      "enumValues": [
        "default",
        "bordered",
        "divided"
      ]
    },
    {
      "name": "data-density",
      "type": "enum",
      "description": "compact | default | comfortable",
      "default": "default",
      "enumValues": [
        "compact",
        "default",
        "comfortable"
      ]
    },
    {
      "name": "data-heading",
      "type": "string",
      "description": "Optional list heading text"
    },
    {
      "name": "data-empty",
      "type": "string",
      "description": "Empty-state message (shown when no"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "sherpa-list-item children"
    },
    {
      "name": "actions",
      "description": "Header actions (buttons / menu)",
      "accepts": [
        "control"
      ]
    }
  ],
  "events": [],
  "properties": [
    {
      "name": "items",
      "type": "sherpa-list-item[]",
      "description": "Live list of light-DOM list items (getter-only)"
    }
  ]
}
