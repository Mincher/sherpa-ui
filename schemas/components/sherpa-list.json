{
  "tagName": "sherpa-list",
  "description": "Grouping container for sherpa-list-item children. Provides variant + density styling, an optional heading row with actions slot, and an automatic empty-state.",
  "category": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data",
      "type": "enum",
      "description": "variant=default]   default | bordered | divided",
      "enumValues": [
        "default",
        "bordered",
        "divided"
      ]
    },
    {
      "name": "data",
      "type": "enum",
      "description": "density=default]   compact | default | comfortable",
      "enumValues": [
        "compact",
        "default",
        "comfortable"
      ]
    },
    {
      "name": "data",
      "type": "string",
      "description": "heading]           Optional list heading text"
    },
    {
      "name": "data",
      "type": "string",
      "description": "empty]             Empty-state message (shown when no"
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "sherpa-list-item children"
    },
    {
      "name": "actions",
      "description": "Header actions (buttons / menu)"
    }
  ],
  "events": [],
  "properties": [
    {
      "name": "items",
      "type": "sherpa-list-item[]",
      "description": "Live list of light-DOM list items (getter-only)"
    }
  ]
}
