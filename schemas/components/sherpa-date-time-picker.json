{
  "tagName": "sherpa-date-time-picker",
  "description": "Combined date + time picker popup panel.",
  "category": "input",
  "tier": 4,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "value",
      "type": "string",
      "description": "Current date-time value (YYYY-MM-DDTHH:mm)"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Disabled state"
    },
    {
      "name": "min",
      "type": "string",
      "description": "Minimum selectable date-time (YYYY-MM-DDTHH:mm)"
    },
    {
      "name": "max",
      "type": "string",
      "description": "Maximum selectable date-time (YYYY-MM-DDTHH:mm)"
    },
    {
      "name": "data-mode",
      "type": "enum",
      "description": "'date-time' (default) | 'date' | 'time'"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "datetime-change",
      "description": "User changed date or time",
      "bubbles": true,
      "composed": true,
      "detail": {
        "value": "string }   ISO datetime (YYYY-MM-DDTHH:mm)"
      }
    },
    {
      "name": "datetime-submit",
      "description": "Apply button clicked",
      "bubbles": true,
      "composed": true,
      "detail": {
        "value": "string"
      }
    },
    {
      "name": "datetime-close",
      "description": "Close button clicked",
      "bubbles": true,
      "composed": true,
      "detail": null
    }
  ],
  "properties": [
    {
      "name": "value",
      "type": "string",
      "description": "Current date-time value (read/write)"
    }
  ]
}
