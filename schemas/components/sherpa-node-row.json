{
  "tagName": "sherpa-node-row",
  "description": "sherpa-node-row.js — Unified row component for sherpa-node. Handles both header rows and body rows via data-variant attribute. Pure layout component. Holds slots; emits events only for header actions. Slot presence is auto-mirrored on the host as data-has-{slotname} via SherpaElement's default onSlotChange handler.",
  "category": "content",
  "tier": 3,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-variant",
      "type": "enum",
      "description": "\"header\" | \"body\" (default: \"body\")"
    },
    {
      "name": "data-multi",
      "type": "boolean",
      "description": "Visually expand for multi-input rows"
    },
    {
      "name": "data-icon",
      "type": "string",
      "description": "FontAwesome class for built-in icon (header variant only)"
    },
    {
      "name": "data-drill-down",
      "type": "boolean",
      "description": "Show drill-down button (header variant only)"
    }
  ],
  "slots": [
    {
      "name": "icon",
      "description": "Custom leading icon (header variant only, overrides data-icon)"
    },
    {
      "name": "title",
      "description": "Header title text (header variant)"
    },
    {
      "name": "actions",
      "description": "Trailing icons/buttons (header variant)"
    },
    {
      "name": "label",
      "description": "Field label (body variant)"
    },
    {
      "name": "control",
      "description": "Input/select/chip group (body variant)"
    },
    {
      "name": "helper",
      "description": "Optional helper text (body variant)"
    },
    {
      "name": "input-socket",
      "description": "Slot in the LEFT gutter"
    },
    {
      "name": "output-socket",
      "description": "Slot in the RIGHT gutter"
    }
  ],
  "events": [
    {
      "name": "sherpa-node-drilldown (header variant only)",
      "description": "",
      "bubbles": true,
      "composed": true,
      "detail": null
    }
  ]
}
