{
  "tagName": "sherpa-input-radio",
  "description": "Atomic radio primitive. Single radio with label-on-the-right. Use multiple instances sharing a `name` to form a logical group, or wrap in `sherpa-input-radio-group` which manages the shared name + value coordination.",
  "category": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "name",
      "type": "string",
      "description": "Form field name (radios sharing a name group together)"
    },
    {
      "name": "value",
      "type": "string",
      "description": "Value submitted when selected"
    },
    {
      "name": "checked",
      "type": "boolean",
      "description": "Initial / current selected state"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Disabled state"
    },
    {
      "name": "required",
      "type": "boolean",
      "description": "Required constraint"
    },
    {
      "name": "data-label",
      "type": "string",
      "description": "Inline label text"
    },
    {
      "name": "data-description",
      "type": "string",
      "description": "Helper line below the label"
    },
    {
      "name": "data-status",
      "type": "enum",
      "description": "critical | warning | success | info | urgent",
      "enumValues": [
        "critical",
        "warning",
        "success",
        "info",
        "urgent"
      ]
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "change",
      "description": "User selected this radio.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "checked": "boolean",
        "value": "string"
      }
    }
  ],
  "methods": [
    {
      "name": "focus()",
      "description": "Move focus to the underlying native input."
    }
  ],
  "properties": [
    {
      "name": "checked",
      "type": "boolean",
      "description": "Read/write checked state"
    },
    {
      "name": "value",
      "type": "string",
      "description": "Submitted value"
    }
  ]
}
