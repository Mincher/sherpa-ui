{
  "tagName": "sherpa-input-select",
  "description": "Dropdown select input using native <select>. Options provided via light DOM <option> elements or programmatically via setOptions(). Inherits label, description, helper, layout, validation from SherpaInputBase.",
  "category": "input",
  "tier": 4,
  "group": "form",
  "baseClass": "SherpaInputBase",
  "attributes": [
    {
      "name": "data-template",
      "type": "enum",
      "description": "default | tree (hierarchical picker)",
      "enumValues": [
        "default",
        "tree"
      ]
    },
    {
      "name": "data-tree",
      "type": "json",
      "description": "(tree) Node forest [{value,label,children?,disabled?}]"
    },
    {
      "name": "data-label",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "data-description",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "data-helper",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "data-layout",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "disabled",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "readonly",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "required",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "name",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "value",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "placeholder",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "pattern",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "minlength",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "maxlength",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "novalidate",
      "type": "string",
      "description": "",
      "inherited": "SherpaInputBase"
    },
    {
      "name": "data-status",
      "type": "string",
      "description": "",
      "inherited": "StatusMixin"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "change",
      "description": "",
      "bubbles": true,
      "composed": true,
      "detail": {
        "value": "string"
      }
    }
  ],
  "methods": [
    {
      "name": "setOptions(options)",
      "description": "Set option list. Accepts either:",
      "params": [
        {
          "name": "options",
          "type": "any"
        }
      ]
    },
    {
      "name": "setTree(nodes)",
      "description": "(tree) Set the node forest",
      "params": [
        {
          "name": "nodes",
          "type": "any"
        }
      ]
    }
  ]
}
