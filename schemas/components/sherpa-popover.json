{
  "tagName": "sherpa-popover",
  "description": "General-purpose floating content container with header.",
  "category": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-heading",
      "type": "string",
      "description": "Header title text"
    },
    {
      "name": "data-open",
      "type": "boolean",
      "description": "Shows the popover"
    },
    {
      "name": "data-anchor",
      "type": "string",
      "description": "CSS anchor name to position against"
    },
    {
      "name": "data-position",
      "type": "enum",
      "description": "top | bottom | left | right",
      "enumValues": [
        "top",
        "bottom",
        "left",
        "right"
      ]
    },
    {
      "name": "data-template",
      "type": "enum",
      "description": "default | paged",
      "enumValues": [
        "default",
        "paged"
      ]
    },
    {
      "name": "data-page",
      "type": "number",
      "description": "(paged) Active 0-based page index"
    },
    {
      "name": "data-pages",
      "type": "number",
      "description": "(paged) Total page count for the indicator"
    },
    {
      "name": "data-animation",
      "type": "enum",
      "description": "none (default) | slide"
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "Default slot for body content (paged: <section data-page=\"N\">)"
    },
    {
      "name": "icon",
      "description": "Header icon slot"
    },
    {
      "name": "header-end",
      "description": "Header trailing content slot"
    }
  ],
  "events": [
    {
      "name": "popover-close",
      "description": "Fired when close button or click-outside dismisses",
      "bubbles": true,
      "composed": true,
      "detail": null
    },
    {
      "name": "popover-page-change",
      "description": "(paged) Fired after the active page changes.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "page": "number",
        "total": "number"
      }
    }
  ],
  "methods": [
    {
      "name": "nextPage()",
      "description": "(paged) Advance to the next page if available."
    },
    {
      "name": "prevPage()",
      "description": "(paged) Step back to the previous page if available."
    },
    {
      "name": "setPage(index)",
      "description": "(paged) Jump to a specific 0-based page.",
      "params": [
        {
          "name": "index",
          "type": "any"
        }
      ]
    }
  ]
}
