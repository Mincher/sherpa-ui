{
  "tagName": "sherpa-toolbar",
  "description": "Generic horizontal toolbar with leading/center/trailing content zones and an optional filters row. Pure layout component — no data logic.",
  "category": "content",
  "tier": 3,
  "group": "page-level",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-density",
      "type": "enum",
      "description": "Display density variant"
    },
    {
      "name": "data-template",
      "type": "enum",
      "description": "Layout variant: default | actions (default: default)",
      "enumValues": [
        "default",
        "actions"
      ]
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [
    {
      "name": "leading",
      "description": "Start zone (title, CTA buttons)",
      "accepts": [
        "control",
        "input",
        "display",
        "content"
      ]
    },
    {
      "name": "center",
      "description": "Center zone (search — grows to fill)",
      "accepts": [
        "control",
        "input",
        "display",
        "content"
      ]
    },
    {
      "name": "trailing",
      "description": "End zone (icon buttons, overflow menu)",
      "accepts": [
        "control",
        "input",
        "display",
        "content"
      ]
    },
    {
      "name": "filters",
      "description": "Below the toolbar row (filter bar, chips)",
      "accepts": [
        "control",
        "input"
      ]
    }
  ],
  "events": []
}
