{
  "tagName": "sherpa-prompt-composer",
  "description": "Auto-growing prompt textarea with circular send button. Designed for AI / chat surfaces.",
  "category": "ai",
  "tier": 3,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-placeholder",
      "type": "string",
      "description": "Placeholder text."
    },
    {
      "name": "data-disabled",
      "type": "boolean",
      "description": "Disables input + send."
    },
    {
      "name": "data-max-height",
      "type": "number",
      "description": "Max textarea height in px (default 160)."
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "prompt-submit",
      "description": "Fired on submit (Enter or send button) when",
      "bubbles": true,
      "composed": false,
      "detail": null
    }
  ],
  "methods": [
    {
      "name": "focus()",
      "description": "Focus the textarea."
    },
    {
      "name": "clear()",
      "description": "Clear and reset the textarea height."
    },
    {
      "name": "setBusy(boolean)",
      "description": "Toggle disabled state.",
      "params": [
        {
          "name": "boolean",
          "type": "any"
        }
      ]
    }
  ],
  "properties": [
    {
      "name": "value",
      "type": "string",
      "description": "Current textarea value."
    }
  ]
}
