{
  "tagName": "sherpa-product-bar-v2",
  "description": "Light-themed product bar (Apr 2026 redesign). System name trigger + time, optional tabs, central search, right-aligned actions.",
  "category": "shell",
  "tier": 1,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-product-name",
      "type": "string",
      "description": "System / product display name"
    },
    {
      "name": "data-time",
      "type": "string",
      "description": "Time string (\"09:00\")"
    },
    {
      "name": "data-show-system",
      "type": "string",
      "description": "\"false\" hides the brand stack"
    },
    {
      "name": "data-show-time",
      "type": "string",
      "description": "\"false\" hides the time line"
    },
    {
      "name": "data-show-system-menu",
      "type": "string",
      "description": "\"false\" hides the dropdown caret"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [
    {
      "name": "tabs",
      "description": "Optional product sub-nav (sets data-has-tabs when populated)"
    },
    {
      "name": "search",
      "description": "Search control; falls back to a default sherpa-input-search"
    },
    {
      "name": "actions",
      "description": "Right-aligned icon buttons + Ask N-zo entry point"
    },
    {
      "name": "system-menu",
      "description": "Organisation / scope picker shown when the system-name"
    }
  ],
  "events": [
    {
      "name": "system-trigger-click",
      "description": "",
      "bubbles": true,
      "composed": true,
      "detail": {
        "name": "string"
      }
    }
  ]
}
