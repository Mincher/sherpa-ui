{
  "tagName": "sherpa-calendar",
  "description": "Standalone calendar component for date selection. Supports single date and date range selection modes. Used by sherpa-input-date, sherpa-input-date-range, and sherpa-date-time-picker.",
  "category": "utility",
  "tier": 5,
  "group": "core",
  "baseClass": "SherpaElement",
  "attributes": [
    {
      "name": "data-value",
      "type": "string",
      "description": "Selected date (ISO format: YYYY-MM-DD)"
    },
    {
      "name": "data-value-end",
      "type": "string",
      "description": "End date for range selection (ISO format)"
    },
    {
      "name": "data-min",
      "type": "string",
      "description": "Minimum selectable date (ISO format)"
    },
    {
      "name": "data-max",
      "type": "string",
      "description": "Maximum selectable date (ISO format)"
    },
    {
      "name": "data-mode",
      "type": "enum",
      "description": "single | range (default: single)",
      "enumValues": [
        "single",
        "range"
      ]
    },
    {
      "name": "data-view",
      "type": "enum",
      "description": "day | month | year (default: day)",
      "enumValues": [
        "day",
        "month",
        "year"
      ]
    },
    {
      "name": "data-view-date",
      "type": "string",
      "description": "Currently displayed month (ISO format, defaults to today)"
    },
    {
      "name": "data-src-html",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    },
    {
      "name": "data-src-json",
      "type": "string",
      "description": "",
      "inherited": "SherpaElement"
    }
  ],
  "slots": [
    {
      "name": "header",
      "description": "Custom header content (replaces default month/year navigation)"
    },
    {
      "name": "footer",
      "description": "Footer content (e.g., action buttons, shortcuts)"
    }
  ],
  "events": [
    {
      "name": "dateselect",
      "description": "Dispatched when a single date is selected",
      "bubbles": true,
      "composed": false,
      "detail": {
        "value": "string (ISO)",
        "valueAsDate": "Date"
      }
    },
    {
      "name": "rangeselect",
      "description": "Dispatched when a date range is selected",
      "bubbles": true,
      "composed": false,
      "detail": {
        "start": "string (ISO)",
        "end": "string (ISO)",
        "startAsDate": "Date",
        "endAsDate": "Date"
      }
    },
    {
      "name": "viewchange",
      "description": "Dispatched when month/year view changes",
      "bubbles": true,
      "composed": false,
      "detail": {
        "viewDate": "string (ISO)",
        "view": "'day'|'month'|'year'"
      }
    }
  ],
  "cssParts": [
    {
      "name": "header",
      "description": "Calendar header container"
    },
    {
      "name": "month-label",
      "description": "Month/year label"
    },
    {
      "name": "prev-button",
      "description": "Previous month button"
    },
    {
      "name": "next-button",
      "description": "Next month button"
    },
    {
      "name": "weekdays",
      "description": "Weekday header row"
    },
    {
      "name": "days-grid",
      "description": "Calendar days grid"
    },
    {
      "name": "footer",
      "description": "Footer container"
    }
  ]
}
