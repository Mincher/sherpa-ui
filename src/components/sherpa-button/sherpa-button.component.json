{
  "$comment": "sherpa-button — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-button",
  "$description": "the primary interactive trigger. Two templates, selected by data-type: default (icon(s) + label), icon (square).",
  "element": {
    "$type": "element",
    "tag": "button",
    "attributes": {
      "type": "button"
    },
    "provides": [
      "click",
      "keyboard",
      "focus",
      "disabled"
    ]
  },
  "templates": [
    "default",
    "icon"
  ],
  "anatomy": {
    "byTemplate": {
      "default": [
        {
          "el": "button",
          "class": "trigger sherpa-anchor",
          "part": "trigger",
          "attrs": {
            "type": "button"
          },
          "children": [
            {
              "el": "i",
              "class": "icon sherpa-icon-box icon-start",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "span",
              "class": "label",
              "children": [
                {
                  "slot": "",
                  "attrs": {
                    "data-accepts": "text,icon"
                  }
                }
              ]
            },
            {
              "el": "i",
              "class": "icon sherpa-icon-box icon-end",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "span",
              "class": "badge",
              "children": [
                {
                  "slot": "badge",
                  "attrs": {
                    "data-accepts": "badge"
                  },
                  "children": [
                    {
                      "el": "sherpa-badge",
                      "class": "badge-value"
                    }
                  ]
                }
              ]
            },
            {
              "el": "span",
              "class": "menu-slot",
              "children": [
                {
                  "slot": "menu",
                  "attrs": {
                    "data-accepts": "menu"
                  }
                }
              ]
            }
          ]
        },
        {
          "el": "span",
          "class": "tip sherpa-tip",
          "part": "tip",
          "attrs": {
            "popover": "manual",
            "aria-hidden": "true"
          }
        }
      ],
      "icon": [
        {
          "el": "button",
          "class": "trigger sherpa-anchor",
          "part": "trigger",
          "attrs": {
            "type": "button"
          },
          "children": [
            {
              "el": "i",
              "class": "icon sherpa-icon-box icon-start",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "span",
              "class": "menu-slot",
              "children": [
                {
                  "slot": "menu",
                  "attrs": {
                    "data-accepts": "menu"
                  }
                }
              ]
            }
          ]
        },
        {
          "el": "span",
          "class": "tip sherpa-tip",
          "part": "tip",
          "attrs": {
            "popover": "manual",
            "aria-hidden": "true"
          }
        }
      ]
    }
  },
  "props": [
    {
      "$type": "prop",
      "name": "command",
      "type": "string",
      "observed": false,
      "description": "native: what it is told — `--show`, `--hide`"
    },
    {
      "$type": "prop",
      "name": "commandfor",
      "type": "string",
      "observed": false,
      "description": "native: the id of the element a press commands (a dialog, a panel)"
    },
    {
      "$type": "prop",
      "name": "data-badge",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "the text of the trailing sherpa-badge (or slot a node into \"badge\")"
    },
    {
      "$type": "prop",
      "name": "data-icon-end",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "icon glyph value"
    },
    {
      "$type": "prop",
      "name": "data-icon-start",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "icon glyph value"
    },
    {
      "$type": "prop",
      "name": "data-label",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "label text (or use the default slot)"
    },
    {
      "$type": "prop",
      "name": "data-look",
      "type": "enum",
      "observed": false,
      "kind": "style",
      "values": [
        "saturated",
        "transparent"
      ],
      "description": "saturated (primary) | transparent (tertiary) (omitted = default / \"secondary\": white surface, grey border, dark ink)"
    },
    {
      "$type": "prop",
      "name": "data-no-tab",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "out of the tab order — for a host whose own keys do the same (a stepper)"
    },
    {
      "$type": "prop",
      "name": "data-no-tip",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "visibility",
      "description": "no tooltip — for a host that composes the button and says it itself"
    },
    {
      "$type": "prop",
      "name": "data-open",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "set by JS while its slotted menu is open — CSS only"
    },
    {
      "$type": "prop",
      "name": "data-size",
      "type": "enum",
      "observed": true,
      "declared": true,
      "kind": "style",
      "values": [
        "2xs",
        "xs",
        "sm",
        "lg",
        "xl"
      ],
      "description": "2xs | xs | sm | lg | xl   (default omitted = base size)"
    },
    {
      "$type": "prop",
      "name": "data-status",
      "type": "enum",
      "observed": false,
      "kind": "style",
      "values": [
        "critical",
        "warning",
        "success",
        "info",
        "urgent"
      ],
      "description": "critical | warning | success | info | urgent  (tints the look tier)"
    },
    {
      "$type": "prop",
      "name": "data-tip",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "the tooltip's text. Unset: an unlabelled button's tip is its aria-label, and a labelled one has none"
    },
    {
      "$type": "prop",
      "name": "data-type",
      "type": "enum",
      "observed": true,
      "declared": true,
      "kind": "template",
      "values": [
        "icon"
      ],
      "description": "icon"
    },
    {
      "$type": "prop",
      "name": "disabled",
      "type": "boolean",
      "observed": true,
      "native": true,
      "default": false,
      "description": "native disabled state"
    }
  ],
  "slots": [
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "text",
        "icon"
      ],
      "description": "label content"
    },
    {
      "$type": "slot",
      "name": "badge",
      "accepts": [
        "badge"
      ],
      "description": "trailing badge"
    },
    {
      "$type": "slot",
      "name": "menu",
      "accepts": [
        "menu"
      ],
      "description": "a sherpa-menu this button opens"
    }
  ],
  "populate": {
    "shape": "{ badge?, iconEnd?, iconStart?, label?, noTab?, noTip?, open?, size?, tip?, type? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "states": [
    {
      "$type": "state",
      "name": "transparent",
      "selector": ":host([data-look=\"transparent\"])"
    },
    {
      "$type": "state",
      "name": "open",
      "selector": ":host([data-open])"
    },
    {
      "$type": "state",
      "name": "icon",
      "selector": ":host([data-type=\"icon\"])"
    },
    {
      "$type": "state",
      "name": "icon-start",
      "selector": ":host([data-icon-start])"
    },
    {
      "$type": "state",
      "name": "icon-end",
      "selector": ":host([data-icon-end])"
    },
    {
      "$type": "state",
      "name": "badge",
      "selector": ":host([data-badge])"
    },
    {
      "$type": "state",
      "name": "no-tip",
      "selector": ":host([data-no-tip])"
    },
    {
      "$type": "state",
      "name": "disabled",
      "selector": ":host([disabled])"
    },
    {
      "$type": "state",
      "name": "focus-visible",
      "selector": ".trigger:focus-visible"
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "button-click",
      "bubbles": true,
      "composed": true,
      "trigger": {
        "on": "click",
        "node": ".trigger"
      }
    }
  ],
  "tokens": {
    "trigger.gap": "{sherpa.button-space-gap}",
    "trigger.min-block-size": "{sherpa.button-size-height}",
    "trigger.padding-inline": "{sherpa.button-space-padding}",
    "trigger.font-size": "{sherpa.button-font-size}",
    "trigger.font-weight": "{sherpa.structure-font-weight}",
    "trigger.line-height": "{sherpa.button-font-line-height}",
    "icon.--_icon-size": "{sherpa.button-size-icon}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Button",
      "category": "control",
      "variantAxes": [
        {
          "name": "Type",
          "values": [
            "icon",
            "label"
          ]
        },
        {
          "name": "State",
          "values": [
            "Default"
          ]
        }
      ],
      "booleanProps": [
        "hasIconStart",
        "hasIconEnd",
        "hasBadge"
      ],
      "divergence": {
        "note": "2026-08-26: HTML-element note. Sherpa deliberately does NOT use <a role=\"button\"> — a navigating trigger stays a real link, not a button-styled anchor. For a form SUBMIT (<input type=\"submit\"> / <button type=\"submit\">), use this Button styled Saturated-Default in appearance (the Saturated look-tier, default state). i.e. the submit action of a form is a Saturated-Default Button, not a separate component."
      }
    }
  }
}
