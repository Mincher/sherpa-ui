{
  "$comment": "sherpa-metric — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-metric",
  "$description": "a KPI tile with an optional embedded sparkline.",
  "element": {
    "$type": "element",
    "tag": "sherpa-data-viz-header",
    "attributes": {
      "data-divider": "none"
    },
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "sherpa-data-viz-header",
        "class": "head",
        "part": "header",
        "attrs": {
          "data-divider": "none"
        }
      },
      {
        "el": "div",
        "class": "row",
        "children": [
          {
            "el": "div",
            "class": "figures",
            "children": [
              {
                "el": "p",
                "class": "value",
                "part": "value"
              },
              {
                "el": "div",
                "class": "trend",
                "part": "trend",
                "children": [
                  {
                    "el": "span",
                    "class": "arrow arrow-up",
                    "attrs": {
                      "aria-hidden": "true"
                    }
                  },
                  {
                    "el": "span",
                    "class": "arrow arrow-down",
                    "attrs": {
                      "aria-hidden": "true"
                    }
                  },
                  {
                    "el": "span",
                    "class": "delta",
                    "part": "delta"
                  }
                ]
              }
            ]
          },
          {
            "el": "div",
            "class": "spark",
            "part": "spark",
            "children": [
              {
                "el": "sherpa-sparkline"
              }
            ]
          }
        ]
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-aggregate",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— ASKED of its provider: count | sum | mean | min | max | distinct"
    },
    {
      "$type": "prop",
      "name": "data-bucket",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— a date over-field, cut to day | month | year"
    },
    {
      "$type": "prop",
      "name": "data-delta",
      "type": "string",
      "observed": false,
      "kind": "content",
      "description": "— the change text (e.g. \"+12.5%\")"
    },
    {
      "$type": "prop",
      "name": "data-field",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— the number that aggregate reads"
    },
    {
      "$type": "prop",
      "name": "data-format",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— the value's Intl.NumberFormatOptions, as JSON"
    },
    {
      "$type": "prop",
      "name": "data-icon",
      "type": "string",
      "observed": false,
      "kind": "content",
      "description": "— a glyph before the name"
    },
    {
      "$type": "prop",
      "name": "data-label",
      "type": "string",
      "observed": false,
      "kind": "content",
      "description": "— the metric name, in its header above the value"
    },
    {
      "$type": "prop",
      "name": "data-over-field",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— the sparkline runs over this field"
    },
    {
      "$type": "prop",
      "name": "data-readings",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— its OWN default filter, readings by field as JSON; narrows this tile alone"
    },
    {
      "$type": "prop",
      "name": "data-trend",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "— up | down | flat  (colours the delta + shows the arrow)"
    },
    {
      "$type": "prop",
      "name": "data-value",
      "type": "string",
      "observed": false,
      "kind": "content",
      "description": "— the formatted value string (big number)"
    }
  ],
  "states": [
    {
      "$type": "state",
      "name": "up",
      "selector": ":host([data-trend=\"up\"])"
    },
    {
      "$type": "state",
      "name": "down",
      "selector": ":host([data-trend=\"down\"])"
    },
    {
      "$type": "state",
      "name": "has-values",
      "selector": ":host([data-has-values])"
    },
    {
      "$type": "state",
      "name": "disabled",
      "selector": ":host([disabled])"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (value, series). See $extensions.sherpa.jsProps."
    }
  ],
  "tokens": {
    "row.gap": "{sherpa.structure-space-gap}",
    "row.border-radius": "{sherpa.display-mode-border-rounding-lg}",
    "row.box-shadow": "{sherpa.elevation-offset-x}",
    "figures.gap": "{sherpa.structure-space-gap}",
    "value.font-family": "{sherpa.font-family-mono}",
    "value.font-size": "{sherpa.theme-content-size-h1}",
    "value.font-weight": "{sherpa.font-weight-regular}",
    "value.line-height": "{sherpa.theme-content-line-height-h1}",
    "value.letter-spacing": "{sherpa.theme-content-letter-spacing-h1}",
    "value.color": "{sherpa.theme-content-body-base}",
    "trend.gap": "{sherpa.display-mode-space-2xs}",
    "trend.font-size": "{sherpa.font-size-body-small}",
    "trend.line-height": "{sherpa.theme-content-line-height-small}",
    "trend.color": "{sherpa.style-content-base}",
    "arrow.font-size": "{sherpa.font-size-body-small}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Metric",
      "category": "content",
      "jsProps": [
        {
          "name": "value",
          "type": "number | undefined",
          "access": "read-write"
        },
        {
          "name": "series",
          "type": "readonly number[]",
          "access": "read"
        }
      ]
    }
  }
}
