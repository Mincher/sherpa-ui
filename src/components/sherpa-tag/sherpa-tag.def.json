{
  "$schema": "https://sherpa-ui.dev/schema/component-definition/v2.json",
  "generated": false,
  "name": "sherpa-tag",
  "figmaName": "Tag",
  "category": "control",
  "description": "A compact labelled pill. Neutral by default; colour comes from the [data-status] cascade.",

  "anatomy": {
    "root": {
      "el": "span",
      "class": "pill",
      "part": "pill",
      "figma": { "node": "FRAME", "layout": "HORIZONTAL", "hugHeight": true },
      "children": [
        {
          "el": "span",
          "class": "icon",
          "part": "icon",
          "slot": "icon",
          "attrs": { "aria-hidden": "true" },
          "figma": { "node": "INSTANCE", "source": "icon-glyph" }
        },
        {
          "el": "span",
          "class": "label",
          "slot": "",
          "figma": { "node": "TEXT", "prop": "label" }
        },
        {
          "component": "sherpa-button",
          "relationship": "owned",
          "class": "dismiss",
          "part": "dismiss",
          "showWhen": "removable",
          "attrs": {
            "data-type": "icon",
            "data-variant": "tertiary",
            "data-size": "2xs",
            "data-icon-start": "✕",
            "aria-label": "Remove"
          },
          "figma": { "node": "INSTANCE", "source": "sherpa-button" },
          "listen": [
            { "event": "button-click", "action": "reemit", "as": "tag-remove" }
          ]
        }
      ]
    }
  },

  "props": [
    {
      "name": "data-status",
      "type": "enum",
      "values": ["info", "success", "warning", "critical", "urgent"],
      "default": null,
      "kind": "content",
      "description": "Status colour, applied via the ancestor [data-status] cascade.",
      "figma": {
        "extends": "Status",
        "map": {
          "info":     { "collection": "Status › info",     "mode": "Filled" },
          "success":  { "collection": "Status › success",  "mode": "Filled" },
          "warning":  { "collection": "Status › warning",  "mode": "Filled" },
          "critical": { "collection": "Status › critical", "mode": "Filled" },
          "urgent":   { "collection": "Status › urgent",   "mode": "Filled" }
        }
      }
    },
    {
      "name": "data-icon",
      "type": "boolean",
      "default": false,
      "kind": "visibility",
      "description": "Show the leading icon.",
      "figma": { "boolean": "hasIcon" }
    },
    {
      "name": "data-removable",
      "type": "boolean",
      "default": false,
      "kind": "template",
      "template": "removable",
      "description": "Show the dismiss button (selects the removable template).",
      "figma": { "boolean": "isRemovable" }
    },
    {
      "name": "data-collapsed",
      "type": "boolean",
      "default": false,
      "kind": "style",
      "description": "Render as a small circular indicator.",
      "figma": { "axis": "State", "value": "Collapsed" }
    }
  ],

  "templates": ["default", "removable"],

  "slots": [
    { "name": "icon", "accepts": ["icon"], "description": "A leading glyph." },
    { "name": "", "accepts": ["content"], "description": "The label." }
  ],

  "parts": ["pill", "icon", "dismiss"],

  "nested": [
    { "component": "sherpa-button", "relationship": "owned" }
  ],

  "events": [
    {
      "name": "tag-remove",
      "description": "Fired when the dismiss button is clicked.",
      "bubbles": true,
      "composed": true,
      "cancelable": true,
      "detail": {},
      "trigger": { "from": "child", "component": "sherpa-button", "event": "button-click" },
      "default": {
        "action": "remove-self",
        "description": "The tag removes itself from the DOM. Call preventDefault() to keep it.",
        "cancelableBy": "preventDefault"
      }
    }
  ],

  "overrides": {
    "note": "Consumers do not edit library source. They override from outside.",
    "listen": "Add an event listener; act in app code (most common).",
    "cancel": "For cancelable events, call preventDefault() in the listener to veto the default action.",
    "subclass": "Extend the class and override a lifecycle/handler method, then define a new tag name.",
    "attributes": "Set data-* / native attributes directly — this is the public API, no override needed.",
    "styling": "Restyle exposed part names (see anatomy .part) via ::part(), or set public --sherpa-* tokens."
  },

  "tokens": {
    "pill.gap": "control-space-gap-sm",
    "pill.paddingBlock": "control-space-padding-xs",
    "pill.paddingInline": "control-space-padding-sm",
    "pill.borderWidth": "control-border-width",
    "pill.borderColor": { "override": "status-border", "fallback": "control-border-default" },
    "pill.borderRadius": "core-border-rounding-full",
    "pill.background": { "override": "status-surface", "fallback": "control-surface-default" },
    "pill.color": { "override": "status-text", "fallback": "content-title-base" },
    "pill.fontSize": "core-fonts-scale-sm",
    "pill.fontWeight": "core-fonts-weight-600",
    "icon.size": "size-icon-2xs"
  },

  "figma": {
    "page": "sherpa-tag",
    "baseCollection": "Controls",
    "variantAxes": [
      { "name": "State", "values": ["Default", "Collapsed"] }
    ],
    "booleanProps": ["hasIcon", "isRemovable"],
    "modePins": {
      "Controls": "Default",
      "Elevation": "none"
    }
  }
}
