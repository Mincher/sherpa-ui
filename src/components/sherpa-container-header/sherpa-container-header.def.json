{
  "$schema": "https://sherpa-ui.dev/schema/component-definition/v2.json",
  "generated": false,
  "name": "sherpa-container-header",
  "figmaName": "Container Header",
  "category": "container",
  "description": "The header bar for a container's `header` slot: an optional drag handle + icon, a title + optional description, and a trailing actions region with an optional collapse toggle and dismiss button.",

  "anatomy": {
    "root": {
      "el": "header",
      "class": "row",
      "part": "row",
      "figma": { "node": "COMPONENT", "layout": "HORIZONTAL" },
      "children": [
        { "el": "button", "class": "drag", "part": "drag", "figma": { "node": "INSTANCE", "of": "drag-handle" } },
        { "el": "span", "class": "icon", "part": "icon", "slot": "icon", "figma": { "node": "INSTANCE", "of": "icon" } },
        {
          "el": "div", "class": "labels", "part": "labels",
          "figma": { "node": "FRAME", "layout": "VERTICAL" },
          "children": [
            { "el": "span", "class": "title", "slot": "heading", "figma": { "node": "TEXT", "role": "title" } },
            { "el": "span", "class": "description", "figma": { "node": "TEXT", "role": "secondary" } }
          ]
        },
        {
          "el": "div", "class": "actions", "part": "actions", "slot": "actions",
          "figma": { "node": "SLOT", "layout": "HORIZONTAL" },
          "children": [
            { "el": "button", "class": "toggle", "part": "toggle", "figma": { "node": "INSTANCE", "of": "toggle" } },
            { "el": "button", "class": "close", "part": "close", "figma": { "node": "INSTANCE", "of": "close" } }
          ]
        }
      ]
    }
  },

  "props": [
    { "name": "data-title", "type": "string", "default": null, "kind": "content", "description": "Heading text (or use the heading slot).", "figma": { "text": "heading" } },
    { "name": "data-description", "type": "string", "default": null, "kind": "content", "description": "Secondary text below the heading.", "figma": { "boolean": "hasDescription", "text": "description" } },
    { "name": "data-icon", "type": "string", "default": null, "kind": "content", "description": "A glyph before the title.", "figma": { "boolean": "hasIcon" } },
    { "name": "data-draggable", "type": "boolean", "default": false, "kind": "visibility", "description": "Show the drag handle.", "figma": { "boolean": "hasDragHandle" } },
    { "name": "data-dismissible", "type": "boolean", "default": false, "kind": "visibility", "description": "Show the close button.", "figma": { "boolean": "dismissible" } },
    { "name": "data-collapsible", "type": "boolean", "default": false, "kind": "visibility", "description": "Show the collapse toggle.", "figma": { "boolean": "hasToggle" } },
    { "name": "data-collapsed", "type": "boolean", "default": false, "kind": "content", "description": "Collapsed state (the toggle reflects it).", "figma": { "note": "collapsed" } }
  ],

  "templates": ["default"],

  "slots": [
    { "name": "heading", "accepts": ["content"], "description": "Custom heading element (replaces the default title)." },
    { "name": "icon", "accepts": ["content"], "description": "Custom icon element (else data-icon glyph)." },
    { "name": "actions", "accepts": ["control", "input"], "description": "Extra trailing action controls (before toggle/close)." }
  ],

  "parts": ["row", "drag", "icon", "labels", "title", "description", "actions", "toggle", "close"],

  "nested": [],

  "events": [
    { "name": "container-header-dismiss", "description": "The close button was pressed.", "bubbles": true, "composed": true, "cancelable": false, "detail": {}, "trigger": { "on": "click", "node": ".close" } },
    { "name": "container-header-toggle", "description": "The collapse toggle flipped the collapsed state.", "bubbles": true, "composed": true, "cancelable": false, "detail": { "collapsed": "boolean" }, "trigger": { "on": "click", "node": ".toggle" } },
    { "name": "container-header-drag", "description": "The drag handle received a pointerdown (start of a reorder).", "bubbles": true, "composed": true, "cancelable": false, "detail": {}, "trigger": { "on": "pointerdown", "node": ".drag" } }
  ],

  "tokens": {
    "row.gap": "container-space-gap-sm",
    "row.padding": "container-space-padding-sm",
    "labels.gap": "core-space-3xs",
    "title.color": { "override": "status-text", "fallback": "content-title-base" },
    "description.color": "content-secondary-base",
    "actions.gap": "container-space-gap-sm"
  },

  "figma": {
    "_status": "matched",
    "figmaName": "Container Header",
    "nodeType": "COMPONENT",
    "built": true,
    "variantAxes": [],
    "booleanProps": ["hasDescription", "hasDragHandle", "dismissible", "hasIcon", "hasToggle"],
    "textProps": ["heading", "description"],
    "instanceProps": ["drag-handle", "icon", "close", "toggle"],
    "modePins": {},
    "note": "Rebuilt 2026-08-15 to match Figma Container Header: added drag-handle, icon, close (dismiss) and collapse toggle affordances (all CSS-toggled off data-*) with their events. Was labels + actions only (needs-rebuild)."
  }
}
