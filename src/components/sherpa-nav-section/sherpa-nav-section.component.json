{
  "$comment": "sherpa-nav-section — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-nav-section",
  "$description": "a section label + rule that groups items in a nav rail.",
  "element": {
    "$type": "element",
    "tag": "span",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "span",
        "class": "label sherpa-truncate",
        "part": "label"
      },
      {
        "el": "span",
        "class": "rule",
        "part": "rule",
        "attrs": {
          "aria-hidden": "true"
        }
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-collapsed",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "present on a collapsed rail — hides the label, keeps the rule"
