        {
          "$type": "method",
          "name": "hide",
          "args": "reason: 'reader' | 'width' | 'page' = 'reader'",
          "description": "Close it, and say why: `panel-close` reports it."
        },
        {
          "$type": "method",
          "name": "close",
          "args": "",
          "description": "`hide()`, in the native <dialog>'s spelling."
        },
        {
          "$type": "method",
          "name": "requestMode",
          "args": "mode: PanelMode",
          "description": "Ask for a mode: `panel-mode-change` goes up, and the area that holds the panel writes it on every panel in it. Nobody answering, a panel with no area is its own."
        },
        {
          "$type": "method",
          "name": "minimise",
          "args": "on = !this.minimised",
          "description": "Shrink to a tab (`on`), or open from it as it was; with no word, the other of the two. The keys and the buttons come here. The area mirrors it on the panel beside this one."
        }
      ],
      "commands": [
        {
          "name": "--show",
          "method": "show"
        },
        {
          "name": "--hide",
          "method": "hide"
        }
      ],
      "category": "container",
      "divergence": {
        "note": "2026-09-07 (D2/D12): split out of the former Container Type=overlay-panel variant into a standalone component on native <dialog> opened NON-modally via show() (no backdrop, no focus-trap, no ESC — page stays interactive). Chose <dialog>.show() over the Popover API to share sherpa-dialog's structure + imperative show()/close() lifecycle. Maps to the Figma \"Overlay Panel\" component (Container set already split)."
      },
      "jsProps": [
        {
          "name": "open",
          "type": "boolean",
          "description": "whether the panel is open (delegates to <dialog>)",
          "access": "read-write"
        },
        {
          "name": "search",
          "type": "string",
          "access": "read-write"
        },
        {
          "name": "was",
          "type": "PanelMode",
          "access": "read-write"
        },
        {
          "name": "dockState",
          "type": "'floating' | 'tab' | 'hover' | 'overlay' | 'fixed'",
          "access": "read"
        },
        {
          "name": "minimised",
          "type": "boolean",
          "access": "read"
        },
        {
          "name": "mode",
          "type": "PanelMode",
          "access": "read"
        },
        {
          "name": "side",
          "type": "'start' | 'end'",
          "access": "read"
        },
        {
          "name": "shown",
          "type": "boolean",
          "access": "read"
        }
      ]
    }
  }
}
