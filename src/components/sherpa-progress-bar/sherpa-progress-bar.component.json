{
  "$comment": "sherpa-progress-bar — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-progress-bar",
  "$description": "horizontal task-progress indicator, built on native <progress>. Fill/track are styled via the vendor pseudo-elements (::-webkit-progress-bar / -value, ::-moz-progress-bar); indeterminate = value removed, not set to 0.",
  "element": {
    "$type": "element",
    "tag": "span",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "span",
        "class": "label",
        "part": "label"
      },
      {
        "el": "progress",
        "class": "bar",
        "part": "bar",
        "attrs": {
          "max": "100",
          "value": "0"
        }
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-indeterminate",
      "type": "string",
      "observed": true,
      "kind": "style",
      "default": false,
      "description": "animated sweep for unknown-duration work (boolean; renders a native indeterminate <progress> — no value)"
    },
    {
      "$type": "prop",
      "name": "data-label",
      "type": "string",
      "observed": true,
      "kind": "visibility",
      "description": "accessible task label (shown above the bar; drives aria-label)"
    },
    {
      "$type": "prop",
      "name": "data-status",
      "type": "enum",
      "observed": false,
      "kind": "style",
      "values": [
        "critical",
        "warning",
        "success",
        "info"
      ],
      "description": "critical | warning | success | info  (colours the fill)"
    },
    {
      "$type": "prop",
      "name": "data-value",
      "type": "string",
      "observed": true,
      "kind": "style",
      "description": "0–100 completion percentage (determinate)"
    },
    {
      "$type": "prop",
      "name": "value",
      "type": "string",
      "observed": true,
      "native": true,
      "description": "0–100 completion (native <progress value>); read/write"
    }
  ],
  "states": [
    {
      "$type": "state",
      "name": "label",
      "selector": ":host([data-label])"
    },
    {
      "$type": "state",
      "name": "indeterminate",
      "selector": ":host([data-indeterminate])"
    },
    {
      "$type": "state",
      "name": "disabled",
      "selector": ":host([disabled])"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (value). See $extensions.sherpa.jsProps."
    }
  ],
  "tokens": {
    "label.font-size": "{sherpa.font-size-body-base}",
    "label.line-height": "{sherpa.theme-content-line-height-base}",
    "label.color": "{sherpa.theme-content-body-base}",
    "bar.block-size": "{sherpa.display-mode-space-2xs}",
    "bar.border-radius": "{sherpa.display-mode-border-rounding-full}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Progress Bar (atom)",
      "category": "control",
      "jsProps": [
        {
          "name": "value",
          "type": "number",
          "description": "the current percentage (read/write, clamped 0–100)",
          "access": "read-write"
        }
      ]
    }
  }
}
