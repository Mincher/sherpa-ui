      "description": "read/write JS properties (active, values, savedSets, superseded, readings, heldFields, groupField, sortField, sortDirection, sortSuspended). See $extensions.sherpa.jsProps."
    },
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (setChipValues, setChipReading, drawApplied, drawValueResults, drawCounts, drawResults, nameScope, search, drawPresent, drawOffered, drawReading, supersede, report, available, addFilters, removeFilter, groupSets, drawScope, allowFields, clearAll, organise). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "quick-filter-change",
      "description": "One reader act, as a request: a field's answer, an on or off, the Switch, Clear all.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "active": "string[]",
        "request": "QueryRequest | undefined",
        "scope": "'bar'",
        "values": "Record<string, string[]>"
      }
    },
    {
      "$type": "event",
      "name": "group-change",
      "bubbles": true,
      "composed": true,
      "detail": {
        "field": "null | string"
