        "holds": "string[]",
        "ids": "string[]",
        "scope": "string"
      }
    },
    {
      "$type": "event",
      "name": "graph-reset",
      "description": "Reset node graph: the editor puts its graph back to its starting definition, a draft",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "view-reset",
      "description": "Reset to view defaults: put back the View's own filters, in every scope.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filter-apply",
      "description": "Apply, where the scope waits: send every change held in it.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filter-discard",
      "description": "Discard, where the scope waits: put back the applied answer — a menu's, its field's; the bar's, every field's.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "field": "string"
      }
    },
    {
      "$type": "event",
      "name": "filters-apply",
      "description": "A saved set's row was ticked: add it to this bar as a preset, on.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-dismiss",
      "description": "A saved set's row was unticked: its chip goes, and what it held.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-save",
      "description": "Save filters: under a new name.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-save-as",
      "description": "Save filters as: a new set, by name.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-manage",
      "description": "Manage Saved Filters: the host opens its dialog, to rename and remove the reader's sets.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "limit-options-change",
      "description": "The ⋮ menu's \"Limit to matching filters\".",
      "bubbles": true,
      "composed": true,
      "detail": {
        "on": "boolean"
      }
    },
    {
      "$type": "event",
      "name": "hide-unmatched-change",
      "description": "The ⋮ menu's \"Hide invalid filters\" row, while Limit is on.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "on": "boolean"
      }
    },
    {
      "$type": "event",
      "name": "data-refresh",
      "description": "Refresh: load the page's data again.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "ai-filter-request",
      "description": "Suggest filters was pressed.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "node-editor-open",
      "description": "Open in Node Editor was picked in the ⋮ menu: an outlet opens the page's Query in its `query` graph View.",
      "bubbles": true,
      "composed": true
    }
  ],
  "tokens": {
    "more-item.padding": "{sherpa.display-mode-space-xs}",
    "more-item.color": "{sherpa.style-content-base}",
    "more-item.font-size": "{sherpa.font-size-body-base}",
    "more-item.line-height": "{sherpa.theme-content-line-height-base}",
