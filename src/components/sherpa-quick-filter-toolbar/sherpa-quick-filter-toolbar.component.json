    "act-divider.background": "{sherpa.theme-border-default-2}",
    "chips.gap": "{sherpa.display-mode-space-xs}",
    "actions-zone.gap": "{sherpa.display-mode-space-xs}",
    "view-delete.color": "{sherpa.style-content-base}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Filter Toolbar",
      "methods": [
        {
          "$type": "method",
          "name": "setChipValues",
          "args": "id: string, picks: readonly string[] | undefined",
          "description": "Set ONE chip's picks, leaving every other chip alone."
        },
        {
          "$type": "method",
          "name": "setChipReading",
          "args": "id: string, reading: FieldReading",
          "description": "setChipReading(id, reading) — steer ONE chip with a whole reading."
        },
        {
          "$type": "method",
          "name": "drawResults",
          "args": "results: Readonly<Record<string, number>>",
          "description": "drawResults(results) — each answered chip's results, from its source: the rows that reach it — the filters before it — and match its answer, by field or saved-filter id. SILENT. A chip with none shows no number. Will, TODO 60."
        },
        {
          "$type": "method",
          "name": "drawPresent",
          "args": "present: Readonly<Record<string, readonly string[]>>",
          "description": "drawPresent(present) — a bound source says what the filters before each field leave; a chip's menu greys the rest. SILENT. A field not named is not limited."
        },
        {
          "$type": "method",
          "name": "drawOffered",
          "args": "offered: Readonly<Record<string, readonly string[]>>",
          "description": "drawOffered(offered) — what each serial-set field OFFERS: its menu removes the rest, but keeps a pick."
        },
        {
          "$type": "method",
          "name": "drawReading",
          "args": "field: string, reading: FieldReading",
          "description": "drawReading(field, reading) — a bound source tells this bar one field's answer, whoever set it. SILENT, as every steer is. A SUPERSEDED chip keeps the reader's own picks for when the view lets go."
        },
        {
          "$type": "method",
          "name": "supersede",
          "args": "ids: readonly string[], appliedAt?: string",
          "description": "supersede([...ids]) — the VIEW now owns these fields."
        },
        {
          "$type": "method",
          "name": "report",
          "args": "",
          "description": "report() — re-announce the WHOLE bar, as a reader's own change would."
        },
        {
          "$type": "method",
          "name": "available",
          "args": "defs: FilterDef[]",
          "description": "available([...]) — the filters the Add chip offers, over the populate() set."
        },
        {
          "$type": "method",
          "name": "addFilters",
          "args": "ids: readonly string[]",
          "description": "addFilters([...ids]) — put offered filters on this bar, as the Add button does. The one door, so a panel's Add and the bar's own Add cannot drift."
        },
        {
          "$type": "method",
          "name": "removeFilter",
          "args": "id: string",
          "description": "removeFilter(id) — take one filter off this bar, as its menu's Remove does. The other half of `addFilters`, for the same reason: a filter panel draws its own Remove and cannot reach this shadow root."
        },
        {
          "$type": "method",
          "name": "groupSets",
          "args": "sets: readonly FilterSet[]",
          "description": "groupSets([...]) — the scope's filter SETS: each set's chips are drawn together, in its order — plain chips, never grouped (Will, TODO 241). TODO 99"
        },
        {
          "$type": "method",
          "name": "drawScope",
          "args": "scope: ScopeDescription",
          "description": "drawScope(scope) — draw what a scope holds, SILENTLY, from the description the panel is drawn each of: its chips, each field's answer and each saved filter on or off. Nothing is reported — the source already holds all of it. A PERSISTENT chip (the View) is the host's to set, so it is left alone."
        },
        {
          "$type": "method",
          "name": "allowFields",
          "args": "list: AllowList",
          "description": "allowFields([...]) — the ONLY fields this bar may offer, or `null` for all."
        },
        {
          "$type": "method",
          "name": "clearAll",
          "args": "options: { organise?: boolean; carry?: boolean } = {}",
          "description": "organise chips included; three events afterwards. `{ organise: false }` keeps Group and Sort, which a VIEW sets itself; `{ carry: true }` keeps a carry-over chip, as a View change does. A field chip is EMPTIED — ticks, op, typing and rows — and redrawn, so an off chip never still names what it held."
        },
        {
          "$type": "method",
          "name": "organise",
          "args": "def: OrganiseDef",
          "description": "organise({ group, sort }) — how ONE component arranges the rows it draws."
        }
      ],
      "category": "control",
      "variantAxes": [
        {
          "name": "Type",
          "values": [
            "data",
            "view"
          ]
        }
      ],
      "divergence": {
        "note": "Checked against Figma \"Filter Toolbar\" (150:3688) on 2026-10-16. Figma has two slots, content (chips, divider-separated) and right-actions; the code builds both itself — chips stamped by populate(), the action cluster in its template — and keeps its view and actions slots for a host's extras. Figma's Type=data leads its content with a Switch; the code builds it but hides it unless data-switchable, for legacy reasons (Will, TODO 338), and places it after Group and Sort, which lead the bar. Figma's description names older events; the code's are the contract."
      },
