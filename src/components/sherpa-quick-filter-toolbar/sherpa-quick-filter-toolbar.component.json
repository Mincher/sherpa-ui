    "actions-zone.gap": "{sherpa.display-mode-space-xs}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Filter Toolbar",
      "methods": [
        {
          "$type": "method",
          "name": "setChipValues",
          "args": "id: string, picks: readonly string[] | undefined",
          "description": "Set ONE chip's picks, leaving every other chip alone."
        },
        {
          "$type": "method",
          "name": "setChipReading",
          "args": "id: string, reading: FieldReading",
          "description": "setChipReading(id, reading) — steer ONE chip with a whole reading."
        },
        {
          "$type": "method",
          "name": "drawApplied",
          "args": "applied: Readonly<Record<string, FieldReading>>",
          "description": "drawApplied(applied) — a bound source says what each field that waits for Apply holds APPLIED: a section marks only the values its draft changed. SILENT. TODO 425"
        },
        {
          "$type": "method",
          "name": "drawValueResults",
          "args": "results: Readonly<Record<string, Readonly<Record<string, number>>>>",
          "description": "drawValueResults(results, scope) — each picked value's own count, by field then value: a section's value chips wear them. SILENT. TODO 425"
        },
        {
          "$type": "method",
          "name": "drawCounts",
          "args": "field: string, counts: Readonly<Record<string, number>> | null",
          "description": "drawCounts(field, counts) — a chart's legend drawn here: each value's number, as its chart counts it, for its value chip's badge; null lets it go. Will, TODO 670"
        },
        {
          "$type": "method",
          "name": "drawResults",
          "args": "results: Readonly<Record<string, number>>, _scope?: string, end?: number",
          "description": "drawResults(results, scope, end) — each answered chip's results, from its source: the rows that reach it — the filters before it — and match its answer, by field; `end`, the rows its filters leave. SILENT. A chip with none shows no number. Will, TODO 60."
        },
        {
          "$type": "method",
          "name": "nameScope",
          "args": "scope: { scope?: string; label: string; component?: string | undefined }",
          "description": "nameScope(scope) — its source names its scope: a portrait bar's heading, and the component it narrows. TODO 425"
        },
        {
          "$type": "method",
          "name": "search",
          "args": "text: string",
          "description": "search(text) — a portrait bar shows only the fields whose name, or one of whose values, holds the text; empty shows all. The lead bar's search asks it of every portrait bar beside it. TODO 425"
        },
        {
          "$type": "method",
          "name": "drawPresent",
          "args": "present: Readonly<Record<string, readonly string[]>>",
          "description": "drawPresent(present) — a bound source says what the filters before each field leave; a chip's menu greys the rest. SILENT. A field not named is not limited."
        },
        {
          "$type": "method",
          "name": "drawOffered",
          "args": "offered: Readonly<Record<string, readonly string[]>>",
          "description": "drawOffered(offered) — what each serial-set field OFFERS: its menu removes the rest, but keeps a pick."
        },
        {
          "$type": "method",
          "name": "drawReading",
          "args": "field: string, reading: FieldReading",
          "description": "drawReading(field, reading) — a bound source tells this bar one field's answer, whoever set it. SILENT, as every steer is. A SUPERSEDED chip keeps the reader's own picks for when the view lets go."
        },
        {
          "$type": "method",
          "name": "supersede",
          "args": "readings: Readonly<Record<string, FieldReading>>, appliedAt?: string",
          "description": "supersede(readings) — the VIEW now owns these fields, each with its answer there."
        },
        {
          "$type": "method",
          "name": "report",
          "args": "",
          "description": "report() — announce the bar with no request: its `values` and `active`, for a host that follows the View chip. Bound, each door already asked."
        },
        {
          "$type": "method",
          "name": "available",
          "args": "defs: FilterDef[]",
          "description": "available([...]) — the filters the Add chip offers, over the populate() set."
        },
        {
          "$type": "method",
          "name": "addFilters",
          "args": "ids: readonly string[]",
          "description": "addFilters([...ids]) — put offered filters on this bar, as the Add button does. The one door, so a host's Add and the bar's own Add cannot drift."
        },
        {
          "$type": "method",
          "name": "removeFilter",
          "args": "id: string",
          "description": "removeFilter(id) — take one filter off this bar, as its menu's Remove does. The other half of `addFilters`, for the same reason: a host draws its own Remove and cannot reach this shadow root."
        },
        {
          "$type": "method",
          "name": "groupSets",
          "args": "sets: readonly FilterSet[]",
          "description": "groupSets([...]) — the scope's filter SETS: each set's chips are drawn together, in its order — plain chips, never grouped (Will, TODO 241). TODO 99"
        },
        {
          "$type": "method",
          "name": "drawScope",
          "args": "scope: ScopeDescription, live?: () => ScopeDescription",
          "description": "drawScope(scope, live) — draw what a scope holds, SILENTLY, from the description the panel is drawn each of: its chips and each field's answer. Nothing is reported — the source already holds all of it. A PERSISTENT chip (the View) is the host's to set, so it is left alone."
        },
        {
          "$type": "method",
          "name": "allowFields",
          "args": "list: AllowList",
          "description": "allowFields([...]) — the ONLY fields this bar may offer, or `null` for all."
        },
        {
          "$type": "method",
          "name": "clearAll",
          "args": "options: { organise?: boolean; carry?: boolean } = {}",
          "description": "organise chips included; three events afterwards. `{ organise: false }` keeps Group and Sort, which a VIEW sets itself; `{ carry: true }` keeps a carry-over chip, as a View change does. A field chip is EMPTIED — ticks, op, typing and rows — and redrawn, so an off chip never still names what it held."
        },
        {
          "$type": "method",
          "name": "organise",
          "args": "def: OrganiseDef",
          "description": "organise({ group, sort }) — how ONE component arranges the rows it draws."
        }
      ],
      "category": "control",
      "variantAxes": [
        {
          "name": "Type",
          "values": [
            "data",
            "view"
          ]
        }
      ],
      "divergence": {
        "note": "Checked against Figma \"Filter Toolbar\" (150:3688) on 2026-10-16. Figma has two slots, content (chips, divider-separated) and right-actions; the code builds both itself — chips stamped by populate(), the action cluster in its template — and keeps its view and actions slots for a host's extras. Figma's Type=data leads its content with a Switch; the code builds it but hides it unless data-switchable, for legacy reasons (Will, TODO 338), and places it after Group and Sort, which lead the bar. Figma's description names older events; the code's are the contract."
      },
      "jsProps": [
        {
          "name": "active",
          "type": "string[]",
          "access": "read"
        },
        {
          "name": "values",
          "type": "Record<string, string[]>",
          "access": "read-write"
        },
        {
          "name": "savedSets",
          "type": "SavedSet[]",
          "access": "read-write"
        },
        {
          "name": "superseded",
          "type": "string[]",
          "access": "read"
        },
        {
          "name": "readings",
          "type": "Record<string, FieldReading & { label: string; values: string[] }>",
          "access": "read"
        },
        {
          "name": "heldFields",
          "type": "string[]",
          "access": "read"
        },
        {
          "name": "groupField",
          "type": "string | null",
          "access": "read"
        },
        {
          "name": "sortField",
          "type": "string | null",
          "access": "read"
        },
        {
          "name": "sortDirection",
          "type": "SortDirection",
          "access": "read"
        },
        {
          "name": "sortSuspended",
          "type": "boolean",
          "access": "read"
        }
      ]
    }
  }
}
