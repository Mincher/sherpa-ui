{
  "$comment": "sherpa-list — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-list",
  "$description": "a vertical row container. Slot sherpa-list-item children, or call populate() to stamp rows from the .row-tpl prototype.",
  "element": {
    "$type": "element",
    "tag": "div",
    "attributes": {
      "role": "list"
    },
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "div",
        "class": "body",
        "part": "body",
        "slot": "",
        "attrs": {
          "role": "list"
        }
      },
      {
        "el": "div",
        "class": "empty",
        "part": "empty",
        "attrs": {
          "role": "status",
          "aria-live": "polite"
        }
      },
      {
        "el": "template",
        "class": "row-tpl",
        "children": [
          {
            "el": "div",
            "class": "row-item",
            "attrs": {
              "role": "listitem"
            },
            "children": [
              {
                "el": "sherpa-list-item",
                "attrs": {
                  "data-attr-data-label": "title",
                  "data-attr-data-description": "description",
                  "data-when-current": "active",
                  "data-when-interactive": "interactive"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-empty",
      "type": "string",
      "observed": true,
      "kind": "content",
      "description": "empty-state message No events of its own — child rows emit item-click, which the list uses to keep a single current row."
    },
    {
      "$type": "prop",
      "name": "data-type",
      "type": "string",
      "observed": false,
      "kind": "style",
      "default": "— dividers between rows",
      "description": "| bordered | plain (no dividers)"
    }
  ],
  "states": [
    {
      "$type": "state",
      "name": "empty-visible",
      "selector": ":host([data-empty-visible])"
    },
    {
      "$type": "state",
      "name": "not-plain",
      "selector": ":host(:not([data-type=\"plain\"]))"
    }
  ],
  "tokens": {
    "empty.padding": "{sherpa.theme-padding-lg}",
    "empty.color": "{sherpa.theme-content-body-1}",
    "empty.font-size": "{sherpa.font-size-body-base}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "List",
      "category": "container"
    }
  }
}
