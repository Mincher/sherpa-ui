{
  "$comment": "sherpa-outlet — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-outlet",
  "$description": "where the route's Context is drawn. It is the app's main landmark, and its light DOM IS the Context: on each route change it loads the one app.json names, runs it, and tears the last one down. TRAP T-an-outlet-loads-the-context",
  "element": {
    "$type": "element",
    "tag": "div",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "div",
        "class": "reach",
        "part": "reach",
        "children": [
          {
            "el": "sherpa-callout",
            "class": "reach-unreached",
            "attrs": {
              "data-status": "warning",
              "role": "note",
              "data-heading": "Unable to reach data"
            },
            "children": [
              {
                "el": "span",
                "children": [
                  {
                    "el": "span",
                    "class": "reach-why"
                  }
                ]
              },
              {
                "el": "span",
                "class": "reach-actions",
                "children": [
                  {
                    "el": "sherpa-button",
                    "class": "retry",
                    "attrs": {
                      "data-size": "sm",
                      "data-label": "Retry"
                    }
                  },
                  {
                    "el": "sherpa-button",
                    "class": "dismiss",
                    "attrs": {
                      "data-size": "sm",
                      "data-look": "transparent",
                      "data-label": "Dismiss"
                    }
                  }
                ]
              }
            ]
          },
          {
            "el": "sherpa-callout",
            "class": "reach-down",
            "attrs": {
              "data-status": "critical",
              "role": "alert",
              "data-heading": "Unable to reach data"
            },
            "children": [
              {
                "el": "span",
                "children": [
                  {
                    "el": "span",
                    "class": "reach-why"
                  }
                ]
              },
              {
                "el": "span",
                "class": "reach-actions",
                "children": [
                  {
                    "el": "sherpa-button",
                    "class": "retry",
                    "attrs": {
                      "data-size": "sm",
                      "data-label": "Retry"
                    }
                  },
                  {
                    "el": "sherpa-button",
                    "class": "dismiss",
                    "attrs": {
                      "data-size": "sm",
                      "data-look": "transparent",
                      "data-label": "Dismiss"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "el": "div",
        "class": "reach-say",
        "attrs": {
          "role": "status"
        }
      },
      {
        "el": "div",
        "class": "reach-after",
        "attrs": {
          "tabindex": "-1"
        }
      },
      {
        "slot": "",
        "attrs": {
          "data-accepts": "content"
        }
      },
      {
        "el": "template",
        "class": "words",
        "children": [
          {
            "el": "span",
            "attrs": {
              "data-word": "unreached"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "offline"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "timeout"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "server"
            }
          }
        ]
      }
    ]
  },
  "slots": [
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "content"
      ],
      "description": "the Context's markup, put there by the outlet"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (context, settingsPage, viewsReady). See $extensions.sherpa.jsProps."
    },
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (viewsOf, firstView, refreshNav, start). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "context-change",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "string",
        "view": "null | string"
      }
    },
    {
      "$type": "event",
      "name": "context-markup",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "string",
        "root": "this",
        "waitUntil": "(work: Promise<unknown>) => undefined"
      }
    },
    {
      "$type": "event",
      "name": "context-load",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "string",
        "view": "null | string"
      }
    },
    {
      "$type": "event",
      "name": "settings-open",
      "bubbles": true,
      "composed": true,
      "detail": {
        "page": "string"
      }
    },
    {
      "$type": "event",
      "name": "settings-close",
      "bubbles": true,
      "composed": true
    }
  ],
  "tokens": {
    "reach-actions.gap": "{sherpa.display-mode-space-2xs}",
    "reach-actions.margin-inline-start": "{sherpa.display-mode-space-xs}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "viewsOf",
          "args": "context: string",
          "description": "A Context's Views: its own, then the reader's saved ones."
        },
        {
          "$type": "method",
          "name": "firstView",
          "args": "context: string",
          "description": "Its first View, which the URL leaves out."
        },
        {
          "$type": "method",
          "name": "refreshNav",
          "args": "",
          "description": "Draw the nav again — after a View is saved or deleted, say."
        },
        {
          "$type": "method",
          "name": "start",
          "args": "options: OutletOptions",
          "description": "Read app.json, load each Context's Views, then open the route's Context. The router's `context` defaults to the app's own."
        }
      ],
      "jsProps": [
        {
          "name": "context",
          "type": "string | null",
          "access": "read"
        },
        {
          "name": "settingsPage",
          "type": "string | null",
          "access": "read"
        },
        {
          "name": "viewsReady",
          "type": "Promise<void>",
          "access": "read"
        }
      ]
    }
  }
}
