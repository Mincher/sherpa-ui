                    "el": "sherpa-button",
                    "class": "dismiss",
                    "attrs": {
                      "data-size": "sm",
                      "data-look": "transparent",
                      "data-label": "Dismiss"
                    }
                  }
                ]
              }
            ]
          },
          {
            "el": "sherpa-callout",
            "class": "reach-down",
            "attrs": {
              "data-type": "banner",
              "data-status": "critical",
              "role": "alert",
              "data-heading": "Unable to reach data"
            },
            "children": [
              {
                "el": "span",
                "children": [
                  {
                    "el": "span",
                    "class": "reach-why"
                  }
                ]
              },
              {
                "el": "span",
                "class": "reach-actions",
                "children": [
                  {
                    "el": "sherpa-button",
                    "class": "retry",
                    "attrs": {
                      "data-size": "sm",
                      "data-label": "Retry"
                    }
                  },
                  {
                    "el": "sherpa-button",
                    "class": "dismiss",
                    "attrs": {
                      "data-size": "sm",
                      "data-look": "transparent",
                      "data-label": "Dismiss"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "el": "div",
        "class": "reach-say",
        "attrs": {
          "role": "status"
        }
      },
      {
        "el": "div",
        "class": "reach-after",
        "attrs": {
          "tabindex": "-1"
        }
      },
      {
        "slot": "",
        "attrs": {
          "data-accepts": "content"
        }
      },
      {
        "el": "sherpa-dialog",
        "class": "flow",
        "part": "flow",
        "children": [
          {
            "el": "p",
            "class": "flow-about"
          },
          {
            "el": "div",
            "class": "flow-steps"
          },
          {
            "el": "p",
            "class": "flow-said"
          },
          {
            "el": "sherpa-callout",
            "class": "flow-refused",
            "attrs": {
              "data-status": "critical",
              "role": "alert"
            },
            "children": [
              {
                "el": "span",
                "class": "flow-refused-words"
              }
            ]
          },
          {
            "el": "div",
            "class": "flow-actions",
            "attrs": {
              "slot": "footer"
            },
            "children": [
              {
                "el": "sherpa-button",
                "class": "flow-cancel",
                "attrs": {
                  "data-look": "transparent",
                  "data-label": "Cancel"
                }
              },
              {
                "el": "sherpa-button",
                "class": "flow-run",
                "attrs": {
                  "disabled": ""
                }
              }
            ]
          }
        ]
      },
      {
        "el": "template",
        "class": "flow-text",
        "children": [
          {
            "el": "sherpa-input-text",
            "class": "flow-step",
            "attrs": {
              "data-attr-data-field": "field",
              "data-attr-data-label": "label",
              "data-attr-data-description": "description"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "flow-number",
        "children": [
          {
            "el": "sherpa-input-text",
            "class": "flow-step",
            "attrs": {
              "data-type": "number",
              "data-attr-data-field": "field",
              "data-attr-data-label": "label",
              "data-attr-data-description": "description"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "flow-one",
        "children": [
          {
            "el": "sherpa-input-text",
            "class": "flow-step",
            "attrs": {
              "data-type": "select",
              "data-attr-data-field": "field",
              "data-attr-data-label": "label",
              "data-attr-data-description": "description"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "flow-many",
        "children": [
          {
            "el": "sherpa-input-text",
            "class": "flow-step",
            "attrs": {
              "data-type": "select",
              "multiple": "",
              "data-attr-data-field": "field",
              "data-attr-data-label": "label",
              "data-attr-data-description": "description"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "flow-boolean",
        "children": [
          {
            "el": "sherpa-switch",
            "class": "flow-step",
            "attrs": {
              "data-attr-data-field": "field",
              "data-attr-data-label": "label",
              "data-attr-data-description": "description"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "words",
        "children": [
          {
            "el": "span",
            "attrs": {
              "data-word": "unreached"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "offline"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "timeout"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "server"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "view"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "presets"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "mine"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "read-only"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "new-graph"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "page"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "undo"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "undone"
            }
          },
          {
            "el": "span",
            "attrs": {
              "data-word": "not-started"
            }
          }
        ]
      }
    ]
  },
  "slots": [
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "content"
      ],
      "description": "the Context's markup, put there by the outlet its own `slot=\"context-header\"` element goes up into the app shell's fixed region, and leaves with the Context"
    }
  ],
  "settings": {},
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (context, settingsPage, graph, viewsReady, contexts, view). See $extensions.sherpa.jsProps."
    },
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (openGraph, viewsOf, firstView, graphViewOf, pageDefinition, reload, refreshNav, act, checkAct, actContext, start, savePageView, deletePageView). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "context-change",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "string",
        "view": "null | string"
      }
    },
    {
      "$type": "event",
      "name": "context-markup",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "string",
        "root": "this",
        "waitUntil": "(work: Promise<unknown>) => undefined"
      }
    },
    {
      "$type": "event",
      "name": "context-load",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "string",
        "view": "null | string"
      }
    },
    {
      "$type": "event",
      "name": "settings-open",
      "bubbles": true,
      "composed": true,
      "detail": {
        "page": "string"
      }
    },
    {
      "$type": "event",
      "name": "settings-close",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "graph-change",
      "description": "The graph View's entity moved.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "graph": "OpenGraph | null",
        "page": "OpenPage | undefined"
      }
    },
    {
      "$type": "event",
      "name": "graph-new",
      "description": "New graph… was picked, a request: prevented, the app makes it.",
      "bubbles": true,
      "cancelable": true,
      "composed": true,
      "detail": {
        "type": "string"
      }
    },
    {
      "$type": "event",
      "name": "act-run",
      "description": "An act ran (pressed, or through act()), or was refused, or was undone: a page draws its change.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "done": "string",
        "id": "string",
        "keys": "readonly unknown[]",
        "refused": "string",
        "undone": "true"
      }
    },
    {
      "$type": "event",
      "name": "act-input",
      "description": "A pressed act needs input, or its flow asks first, a request: prevented, the page asks it; else the outlet's dialog does.",
      "bubbles": true,
      "cancelable": true,
      "composed": true,
      "detail": {
        "id": "string",
        "input": "Record<string, unknown>",
        "keys": "readonly unknown[]"
      }
    }
  ],
  "tokens": {
    "reach.z-index": "{sherpa.layer-banners}",
    "reach-actions.gap": "{sherpa.display-mode-space-2xs}",
    "reach-actions.margin-inline-start": "{sherpa.display-mode-space-xs}",
    "flow-steps.gap": "{sherpa.display-mode-space-sm}",
    "flow-about.margin": "{sherpa.display-mode-space-sm}",
    "flow-said.margin": "{sherpa.display-mode-space-sm}",
    "flow-actions.gap": "{sherpa.display-mode-space-xs}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "openGraph",
          "args": "id: string | null",
          "description": "Open an entity in the graph View on screen; none, its type's first. The graph chip shows it, and the URL follows."
        },
        {
          "$type": "method",
          "name": "viewsOf",
          "args": "context: string",
          "description": "A Context's Views: its own, then the reader's saved ones."
        },
        {
          "$type": "method",
          "name": "firstView",
          "args": "context: string",
          "description": "Its first View, which the URL leaves out."
        },
        {
          "$type": "method",
          "name": "graphViewOf",
          "args": "type: string",
          "description": "Where a graph type's entities are shown: the first Context and View whose graph is that type; none where no View shows it. An act's change, or an agent's, is seen there."
        },
        {
          "$type": "method",
          "name": "pageDefinition",
          "args": "context: string",
          "description": "A Context's page definition as it opens — its file, or its type's page, with the app's last word on it — read, never opened: none where it holds no records. Plan 1008 G1"
        },
        {
          "$type": "method",
          "name": "reload",
          "args": "",
          "description": "Open the Context on screen again: a setting its definition reads moved. Its Query is the tab's, so its filters come back with it. Under Settings, once Settings closes. TODO 436"
        },
        {
          "$type": "method",
          "name": "refreshNav",
          "args": "",
          "description": "Draw the nav again — after a View is saved or deleted, say."
        },
        {
          "$type": "method",
          "name": "act",
          "args": "id: string, call: ActCall = {}",
          "description": "Run an act through the one door, over the stores and the shelf a press uses, and fire `act-run` as a press does; its undo fires it again. It says nothing: the caller says the answer, as N-zo does in its chat. Plan 964 N3"
        },
        {
          "$type": "method",
          "name": "checkAct",
          "args": "id: string, call: ActCall = {}",
          "description": "Why an act would be refused here, before the reader is asked: the door's checks, then the act's own (a use that keeps it, a read-only preset, a body its check refuses). Nothing is written. `{}`: it can run. Plan 964 N3c"
        },
        {
          "$type": "method",
          "name": "actContext",
          "args": "",
          "description": "What an act runs over here — the stores a page may name, each found by its type too (`storeOfType`), the shelf, and the tab's unsaved graph drafts — for a reader outside a page: the chat's flow reads a reference's choices from it. Run an act through `act`, so the page hears it. None before `start`. Plan 964 N4"
        },
        {
          "$type": "method",
          "name": "start",
          "args": "options: OutletOptions",
          "description": "Read app.json, load each Context's Views, then open the route's Context. The router's `context` defaults to the app's own."
        },
        {
          "$type": "method",
          "name": "savePageView",
          "args": "label?: string",
          "description": "Save the View a `query` graph View has open: over the reader's own, or as a new one named, which the Page chip then opens. Its id; none for a preset saved over, or nothing open (plan 960 U4.8b)."
        },
        {
          "$type": "method",
          "name": "deletePageView",
          "args": "",
          "description": "Delete the reader's own View a `query` graph View has open, and open the page on its first (plan 960 U4.8b)."
        }
      ],
      "jsProps": [
        {
          "name": "context",
          "type": "string | null",
          "access": "read"
        },
        {
          "name": "settingsPage",
          "type": "string | null",
          "access": "read"
        },
        {
          "name": "graph",
          "type": "OpenGraph | null",
          "access": "read"
        },
        {
          "name": "viewsReady",
          "type": "Promise<void>",
          "access": "read"
        },
        {
          "name": "contexts",
          "type": "{ id: string; label: string; records: boolean }[]",
          "access": "read"
        },
        {
          "name": "view",
          "type": "string | null",
          "access": "read"
        }
      ]
    }
  }
}
