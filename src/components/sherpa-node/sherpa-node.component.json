{
  "$comment": "sherpa-node — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-node",
  "$description": "one node of a node editor: a card on a sherpa-layout-canvas, at its data-x and data-y. Its HEADER names it, drags it and may carry the whole node's sockets; its content holds its rows. Will, TODO 78. TRAP T-a-node-moves-itself-and-reports · TRAP T-a-node-reads-null-from-what-it-cannot-use",
  "element": {
    "$type": "element",
    "tag": "div",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "root": {
      "el": "div",
      "class": "root",
      "part": "root",
      "children": [
        {
          "el": "span",
          "class": "caption",
          "part": "caption",
          "children": [
            {
              "el": "span",
              "class": "caption-icon sherpa-icon-box",
              "part": "caption-icon",
              "attrs": {
                "aria-hidden": "true",
                "data-icon": "play"
              }
            },
            {
              "el": "span",
              "class": "caption-warn sherpa-icon-box",
              "part": "caption-warn",
              "attrs": {
                "aria-hidden": "true",
                "data-icon": "status-warning"
              }
            },
            {
              "el": "span",
              "class": "caption-text sherpa-truncate",
              "part": "caption-text",
              "attrs": {
                "data-text": "data-caption"
              }
            },
            {
              "el": "span",
              "class": "caption-badge",
              "part": "caption-badge",
              "attrs": {
                "data-text": "data-badge"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "header sherpa-anchor",
          "part": "header",
          "attrs": {
            "role": "button",
            "tabindex": "0",
            "aria-roledescription": "node",
            "aria-describedby": "warning"
          },
          "children": [
            {
              "el": "span",
              "class": "grip sherpa-icon-box",
              "part": "grip",
              "attrs": {
                "aria-hidden": "true",
                "data-icon": "drag-handle-vertical"
              }
            },
            {
              "el": "sherpa-container-header",
              "class": "heading",
              "part": "heading",
              "attrs": {
                "data-heading": "Node",
                "data-attr-data-heading": "data-heading",
                "data-attr-data-icon": "data-icon",
                "data-attr-data-description": "data-description"
              }
            },
            {
              "el": "span",
              "class": "socket socket-in sherpa-anchor",
              "part": "socket-in",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "span",
              "class": "tip tip-in sherpa-tip",
              "part": "tip",
              "attrs": {
                "popover": "manual",
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "name"
                },
                {
                  "el": "span",
                  "class": "word w-value"
                },
                {
                  "el": "span",
                  "class": "word w-object"
                },
                {
                  "el": "span",
                  "class": "word w-boolean"
                },
                {
                  "el": "span",
                  "class": "word w-any"
                }
              ]
            },
            {
              "el": "span",
              "class": "socket socket-out sherpa-anchor",
              "part": "socket-out",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "span",
              "class": "tip tip-out sherpa-tip",
              "part": "tip",
              "attrs": {
                "popover": "manual",
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "name name-out"
                },
                {
                  "el": "span",
                  "class": "name name-true"
                },
                {
                  "el": "span",
                  "class": "word w-value"
                },
                {
                  "el": "span",
                  "class": "word w-object"
                },
                {
                  "el": "span",
                  "class": "word w-boolean"
                }
              ]
            }
          ]
        },
        {
          "el": "span",
          "class": "tip tip-warning sherpa-tip",
          "part": "tip",
          "attrs": {
            "id": "warning",
            "popover": "manual",
            "role": "tooltip",
            "data-text": "data-warning"
          }
        },
        {
          "el": "div",
          "class": "body",
          "part": "body",
          "children": [
            {
              "slot": "",
              "attrs": {
                "data-accepts": "item"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "footer",
          "part": "footer",
          "children": [
            {
              "el": "sherpa-container-footer",
              "class": "foot",
              "part": "foot"
            },
            {
              "el": "span",
              "class": "socket socket-out socket-false sherpa-anchor",
              "part": "socket-false",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "span",
              "class": "tip tip-false sherpa-tip",
              "part": "tip",
              "attrs": {
                "popover": "manual",
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "name"
