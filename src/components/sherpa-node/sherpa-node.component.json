  "props": [
    {
      "$type": "prop",
      "name": "data-active",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the one picked node whose panel is shown, in a stronger ring; the HOST writes it"
    },
    {
      "$type": "prop",
      "name": "data-badge",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "a short count on its tab's right: the rows true after a simulation. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-branches",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a fork: the header's output is True, and a footer shows with its False socket, a rounded square"
    },
    {
      "$type": "prop",
      "name": "data-caption",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "the TAB on its top edge: what its step does or did, its time and rows (\"Simulating… 1s\"). A running tab leads with a play icon. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-category",
      "type": "string",
      "observed": false,
      "declared": true,
      "kind": "style",
      "description": "its kind's category, in lower case: sources | custom-nodes | variables | math | logic | time | utils | collections | output | ai; each has its look"
    },
    {
      "$type": "prop",
      "name": "data-current",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the selected node; the HOST writes it, one node of many"
    },
    {
      "$type": "prop",
      "name": "data-description",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "a line under the name"
    },
    {
      "$type": "prop",
      "name": "data-false-routed",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a route leaves False: its socket is filled, else hollow"
    },
    {
      "$type": "prop",
      "name": "data-heading",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "default": "Node",
      "description": "the node's name, in its header"
    },
    {
      "$type": "prop",
      "name": "data-icon",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "a glyph before the name"
    },
    {
      "$type": "prop",
      "name": "data-input-many",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the header's input takes several routes: its socket is a double height D"
    },
    {
      "$type": "prop",
      "name": "data-input-routed",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a route joins the header's input: its socket is filled, else hollow"
    },
    {
      "$type": "prop",
      "name": "data-input-socket",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "style",
      "values": [
        "value",
        "object",
        "boolean",
        "any"
      ],
      "description": "the whole node's input socket, on its header: value | object | boolean | any: an input is a D, its type in its ink"
    },
    {
      "$type": "prop",
      "name": "data-linked",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a portal of the picked portal's name, In or Out: it takes the picked look; the HOST writes it"
    },
    {
      "$type": "prop",
      "name": "data-locked",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the host owns the place: a drag or a key reports, and moves nothing"
    },
    {
      "$type": "prop",
      "name": "data-output-routed",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a route leaves the header's output: its socket is filled, else hollow"
    },
    {
      "$type": "prop",
      "name": "data-output-socket",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "style",
      "values": [
        "value",
        "object",
        "boolean"
      ],
      "description": "the whole node's output socket, on its header: value (a circle) | object (a diamond) | boolean (a triangle)"
    },
    {
      "$type": "prop",
      "name": "data-resizable",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the resize handle and Alt and an arrow exist: the app's Allow resizing nodes setting writes it. A saved size draws either way"
    },
    {
      "$type": "prop",
      "name": "data-scale-h",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "1",
      "description": "its height, in times its natural height: 1 to 2"
    },
    {
      "$type": "prop",
      "name": "data-scale-w",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "1",
      "description": "its width, in times its natural width: 1 to 2"
    },
    {
      "$type": "prop",
      "name": "data-step",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "style",
      "values": [
        "running",
        "done",
        "failed",
        "skipped"
      ],
      "description": "how its step stands as a run lights it: running | done | failed | skipped. Its host writes it. Running, the node wears the active border"
    },
    {
      "$type": "prop",
      "name": "data-warning",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "what reached it that it cannot use, in words, a line each: it draws as a warning, and a hover or focus on its header shows the words. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-x",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "0",
      "description": "where it sits across the canvas, in plane px"
    },
    {
      "$type": "prop",
      "name": "data-y",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "0",
      "description": "where it sits down the canvas, in plane px"
    }
  ],
  "slots": [
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "item"
      ],
      "description": "the node's rows: each a sherpa-node-row"
    }
  ],
  "populate": {
    "shape": "{ active?, badge?, branches?, caption?, category?, current?, description?, falseRouted?, heading?, icon?, inputMany?, inputRouted?, inputSocket?, linked?, locked?, outputRouted?, outputSocket?, resizable?, scaleH?, scaleW?, step?, warning?, x?, y? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "settings": {
    "data-resizable": "resizeNodes"
  },
  "states": [
    {
      "$type": "state",
      "name": "active",
      "selector": ":host([data-active])"
    },
    {
      "$type": "state",
      "name": "current",
      "selector": ":host([data-current])"
    },
    {
      "$type": "state",
      "name": "linked",
      "selector": ":host([data-linked])"
    },
    {
      "$type": "state",
      "name": "warning",
      "selector": ":host([data-warning])"
    },
    {
      "$type": "state",
      "name": "resizable",
      "selector": ":host([data-resizable])"
    },
    {
      "$type": "state",
      "name": "caption",
      "selector": ":host([data-caption])"
    },
    {
      "$type": "state",
      "name": "running",
      "selector": ":host([data-step=\"running\"])"
    },
    {
      "$type": "state",
      "name": "output-socket",
      "selector": ":host([data-output-socket])"
    },
    {
      "$type": "state",
      "name": "branches",
      "selector": ":host([data-branches])"
    },
    {
      "$type": "state",
      "name": "false-routed",
      "selector": ":host([data-false-routed])"
    },
    {
      "$type": "state",
      "name": "not-warning",
      "selector": ":host(:not([data-warning]))"
    },
    {
      "$type": "state",
      "name": "focus-visible",
      "selector": ".header:focus-visible"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (socketRect). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "node-move",
      "description": "It moved, or was asked to: a drag on its header, or an arrow key there.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "x": "number",
        "y": "number"
      }
    },
    {
      "$type": "event",
      "name": "node-resize",
      "description": "Its resize handle was dragged, or Alt and an arrow pressed on its header.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "h": "number",
        "w": "number"
      }
    },
    {
      "$type": "event",
      "name": "node-select",
      "description": "It was pressed: a click on it, or Enter or Space on its header.",
      "bubbles": true,
      "composed": true
    }
  ],
  "tokens": {
    "root.border-width": "{sherpa.style-border-width}",
    "root.border-radius": "{sherpa.display-mode-border-rounding-base}",
    "root.color": "{sherpa.style-content-base}",
    "grip.margin-block-start": "{sherpa.theme-padding-md}",
    "grip.inline-size": "{sherpa.display-mode-size-sm}",
    "grip.block-size": "{sherpa.display-mode-size-sm}",
    "grip.margin-inline-start": "{sherpa.theme-padding-sm}",
    "grip.color": "{sherpa.style-content-secondary}",
    "resize.inline-size": "{sherpa.display-mode-size-sm}",
    "resize.block-size": "{sherpa.display-mode-size-sm}",
    "resize.color": "{sherpa.style-content-secondary}",
    "caption.gap": "{sherpa.theme-gap-sm}",
    "caption.padding": "{sherpa.theme-padding-xs}",
    "caption.border-width": "{sherpa.style-border-width}",
    "caption.border-start-start-radius": "{sherpa.display-mode-border-rounding-sm}",
    "caption.border-start-end-radius": "{sherpa.display-mode-border-rounding-sm}",
    "caption.color": "{sherpa.style-content-base}",
    "caption.font-family": "{sherpa.font-family-mono}",
    "caption.font-size": "{sherpa.font-size-body-xs}",
    "caption.line-height": "{sherpa.theme-content-line-height-small}",
    "caption-badge.padding-inline": "{sherpa.theme-padding-sm}",
    "caption-badge.border-radius": "{sherpa.display-mode-border-rounding-sm}",
    "caption-badge.background": "{sherpa.style-surface-base-2}",
    "caption-badge.color": "{sherpa.style-content-base}",
    "socket-false.inset-inline-start": "{sherpa.theme-padding-lg}",
    "footer.min-block-size": "{sherpa.display-mode-size-2xl}",
    "body.gap": "{sherpa.theme-gap-md}",
    "body.padding-block": "{sherpa.theme-gap-md}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "socketRect",
          "args": "side: SocketSide",
          "description": "A socket's box on the screen, for a connector to join: the header's, or the footer's False; null when it has none."
        }
      ]
    }
  }
}
