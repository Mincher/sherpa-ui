{
  "$comment": "sherpa-node — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-node",
  "$description": "one node of a node editor: a card on a sherpa-layout-canvas, at its data-x and data-y. Its HEADER names it, drags it and may carry the whole node's sockets; its content holds its rows. Will, TODO 78. TRAP T-a-node-moves-itself-and-reports · TRAP T-a-node-reads-null-from-what-it-cannot-use",
  "element": {
    "$type": "element",
    "tag": "div",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "root": {
      "el": "div",
      "class": "root",
      "part": "root",
      "children": [
        {
          "el": "span",
          "class": "stack stack-in",
          "part": "stack-in",
          "attrs": {
            "aria-hidden": "true"
          }
        },
        {
          "el": "span",
          "class": "stack stack-out",
          "part": "stack-out",
          "attrs": {
            "aria-hidden": "true"
          }
        },
        {
          "el": "span",
          "class": "caption",
          "part": "caption",
          "children": [
            {
              "el": "span",
              "class": "caption-icon sherpa-icon-box",
              "part": "caption-icon",
              "attrs": {
                "aria-hidden": "true",
                "data-icon": "play"
              }
            },
            {
              "el": "span",
              "class": "caption-warn sherpa-icon-box",
              "part": "caption-warn",
              "attrs": {
                "aria-hidden": "true",
                "data-icon": "status-warning"
              }
            },
            {
              "el": "span",
              "class": "caption-text sherpa-truncate",
              "part": "caption-text",
              "attrs": {
                "data-text": "data-caption"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "header sherpa-anchor",
          "part": "header",
          "attrs": {
            "role": "button",
            "tabindex": "0",
            "aria-roledescription": "node",
            "aria-describedby": "warning"
          },
          "children": [
            {
              "el": "sherpa-container-header",
              "class": "heading",
              "part": "heading",
              "attrs": {
                "data-heading": "Node",
                "data-attr-data-icon": "data-icon",
                "data-attr-data-description": "data-description"
              }
            },
            {
              "el": "span",
              "class": "socket-tab socket-tab-in sherpa-anchor",
              "part": "socket-tab-in",
              "attrs": {
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "socket socket-in",
                  "part": "socket-in",
                  "children": [
                    {
                      "el": "i",
                      "class": "core"
                    }
                  ]
                }
              ]
            },
            {
              "el": "span",
              "class": "tip tip-in sherpa-tip",
              "part": "tip",
              "attrs": {
                "popover": "manual",
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "name"
                },
                {
                  "el": "span",
                  "class": "word w-value"
                },
                {
                  "el": "span",
                  "class": "word w-object"
                },
                {
                  "el": "span",
                  "class": "word w-boolean"
                },
                {
                  "el": "span",
                  "class": "word w-any"
                }
              ]
            },
            {
              "el": "span",
              "class": "socket-tab socket-tab-out sherpa-anchor",
              "part": "socket-tab-out",
              "attrs": {
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "socket socket-out",
                  "part": "socket-out",
                  "children": [
                    {
                      "el": "i",
                      "class": "core"
                    }
                  ]
                }
              ]
            },
            {
              "el": "span",
              "class": "tip tip-out sherpa-tip",
              "part": "tip",
              "attrs": {
                "popover": "manual",
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "span",
                  "class": "name name-out"
                },
                {
                  "el": "span",
                  "class": "word w-value"
                },
                {
                  "el": "span",
                  "class": "word w-object"
                },
                {
                  "el": "span",
                  "class": "word w-boolean"
                }
              ]
            }
          ]
        },
        {
          "el": "sherpa-button",
          "class": "open",
          "part": "open",
          "attrs": {
            "data-type": "icon",
            "data-look": "transparent",
            "data-size": "sm",
            "data-icon-start": "folder-open",
            "aria-label": "Open graph",
            "data-tip": "Open graph"
          }
        },
        {
          "el": "span",
          "class": "tip tip-warning sherpa-tip",
          "part": "tip",
          "attrs": {
            "id": "warning",
            "popover": "manual",
            "role": "tooltip",
            "data-text": "data-warning"
          }
        },
        {
          "el": "div",
          "class": "body",
          "part": "body",
          "children": [
            {
              "slot": "",
              "attrs": {
                "data-accepts": "item"
              }
            }
          ]
        },
        {
          "el": "span",
          "class": "resize",
          "part": "resize",
          "attrs": {
            "aria-hidden": "true",
            "title": "Drag to resize. Hold Ctrl to keep the shape."
          }
        }
      ]
    }
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-active",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the one picked node whose panel is shown, in a stronger ring; the HOST writes it"
    },
    {
      "$type": "prop",
      "name": "data-caption",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "the TAB on its top edge: what its step does or did, its time and rows (\"Simulating… 1s\"). A running tab leads with a play icon. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-category",
      "type": "string",
      "observed": false,
      "declared": true,
      "kind": "style",
      "description": "its kind's category, in lower case: sources | custom-nodes | variables | math | logic | time | utils | collections | output | ai; each has its look"
    },
    {
      "$type": "prop",
      "name": "data-chain-drag",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "⌘ or Ctrl held on a drag or an arrow asks to pull the nodes it joins: the app's Enable node chain dragging setting writes it"
    },
    {
      "$type": "prop",
      "name": "data-chain-falloff",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "behaviour",
      "values": [
        "distance",
        "connections"
      ],
      "description": "distance | connections: what that pull falls off by, the distance along the connectors (none: it) or how many: the app's setting writes it"
    },
    {
      "$type": "prop",
      "name": "data-collapsed",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "collapsed: its rows show only their sockets, no label or field; a socket's tip names its row and says its value, and its name reads \"Heading: summary\". Its host writes it data-inputs, data-outputs  how many sockets each side's stack holds, collapsed: the header's and the rows'. Its host writes them data-inputs-connected, data-outputs-connected  the same, of the connected ones only: hiding the unconnected, the stacks hold these. Its host writes them"
    },
    {
      "$type": "prop",
      "name": "data-current",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the selected node; the HOST writes it, one node of many"
    },
    {
      "$type": "prop",
      "name": "data-description",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "a line under the name"
    },
    {
      "$type": "prop",
      "name": "data-heading",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "the node's name, in its header"
    },
    {
      "$type": "prop",
      "name": "data-hide-unconnected",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "collapsed, a socket no connection joins hides; a hover shows them. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-icon",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "a glyph before the name"
    },
    {
      "$type": "prop",
      "name": "data-input-connected",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a connection joins the header's input: its socket is filled, else hollow"
    },
    {
      "$type": "prop",
      "name": "data-input-many",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the header's input takes several connections"
    },
    {
      "$type": "prop",
      "name": "data-input-socket",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "style",
      "values": [
        "value",
        "object",
        "boolean",
        "any"
      ],
      "description": "the whole node's input socket, on its header: value (a circle) | object (a diamond) | boolean (a square) | any (a grey circle)"
    },
    {
      "$type": "prop",
      "name": "data-inputs",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour"
    },
    {
      "$type": "prop",
      "name": "data-inputs-connected",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour"
    },
    {
      "$type": "prop",
      "name": "data-joined",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "joined to what is picked: downstream of a picked node, at an end of a picked connection, or joined to the row in focus. It wears the active border on its own fill. The HOST writes it"
    },
    {
      "$type": "prop",
      "name": "data-kind",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "its kind's name, where the node has a name of its own: the header says it first (\"Field: Device type\"). Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-linked",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a portal of the picked portal's name, In or Out: it takes the picked look; the HOST writes it"
    },
    {
      "$type": "prop",
      "name": "data-locked",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the host owns the place: a drag or a key reports, and moves nothing"
    },
    {
      "$type": "prop",
      "name": "data-output-connected",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a connection leaves the header's output: its socket is filled, else hollow"
    },
    {
      "$type": "prop",
      "name": "data-output-socket",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "style",
      "values": [
        "value",
        "object",
        "boolean"
      ],
      "description": "the whole node's output socket, on its header: value (a circle) | object (a diamond) | boolean (a square)"
    },
    {
      "$type": "prop",
      "name": "data-outputs",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour"
    },
    {
      "$type": "prop",
      "name": "data-outputs-connected",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour"
    },
    {
      "$type": "prop",
      "name": "data-resizable",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the resize handle and Alt and an arrow exist: the app's Allow resizing nodes setting writes it. A saved size draws either way"
    },
    {
      "$type": "prop",
      "name": "data-reveal",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the hidden sockets show, as on a hover: a line is being dragged. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-scale-h",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "1",
      "description": "its height, in times its natural height: 1 to 2"
    },
    {
      "$type": "prop",
      "name": "data-scale-w",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "1",
      "description": "its width, in times its natural width: 1 to 2"
    },
    {
      "$type": "prop",
      "name": "data-step",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "style",
      "values": [
        "running",
        "done",
        "failed",
        "skipped"
      ],
      "description": "how its step stands as a run lights it: running | done | failed | skipped. Its host writes it. Running, the node wears the active border"
    },
    {
      "$type": "prop",
      "name": "data-sub-graph",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "it holds a sub-graph, as a Custom Node's use: a drill-down button on its header's end opens it (node-open). Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-summary",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "what its first field holds, in words: a collapsed node's name ends with it (\"Condition: Equals\"). Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-warning",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "what reached it that it cannot use, in words, a line each: it draws as a warning, and a hover or focus on its header shows the words. Its host writes it"
    },
    {
      "$type": "prop",
      "name": "data-x",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "0",
      "description": "where it sits across the canvas, in plane px"
    },
    {
      "$type": "prop",
      "name": "data-y",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "default": "0",
      "description": "where it sits down the canvas, in plane px"
    }
  ],
  "slots": [
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "item"
      ],
      "description": "the node's rows: each a sherpa-node-row"
    }
  ],
  "populate": {
    "shape": "{ active?, caption?, category?, chainDrag?, chainFalloff?, collapsed?, current?, description?, heading?, hideUnconnected?, icon?, inputConnected?, inputMany?, inputSocket?, inputs?, inputsConnected?, joined?, kind?, linked?, locked?, outputConnected?, outputSocket?, outputs?, outputsConnected?, resizable?, reveal?, scaleH?, scaleW?, step?, subGraph?, summary?, warning?, x?, y? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "settings": {
    "data-resizable": "resizeNodes",
    "data-chain-drag": "chainDrag",
    "data-chain-falloff": "chainFalloff"
  },
  "states": [
    {
      "$type": "state",
      "name": "active",
      "selector": ":host([data-active])"
    },
    {
      "$type": "state",
      "name": "current",
      "selector": ":host([data-current])"
    },
    {
      "$type": "state",
      "name": "linked",
      "selector": ":host([data-linked])"
    },
    {
      "$type": "state",
      "name": "warning",
      "selector": ":host([data-warning])"
    },
    {
      "$type": "state",
      "name": "joined",
      "selector": ":host([data-joined])"
    },
    {
      "$type": "state",
      "name": "sm",
      "selector": ":host([data-elevation=\"sm\"])"
    },
    {
      "$type": "state",
      "name": "md",
      "selector": ":host([data-elevation=\"md\"])"
    },
    {
      "$type": "state",
      "name": "lg",
      "selector": ":host([data-elevation=\"lg\"])"
    },
    {
      "$type": "state",
      "name": "sub-graph",
      "selector": ":host([data-sub-graph])"
    },
    {
      "$type": "state",
      "name": "resizable",
      "selector": ":host([data-resizable])"
    },
    {
      "$type": "state",
      "name": "caption",
      "selector": ":host([data-caption])"
    },
    {
      "$type": "state",
      "name": "running",
      "selector": ":host([data-step=\"running\"])"
    },
    {
      "$type": "state",
      "name": "input-socket",
      "selector": ":host([data-input-socket])"
    },
    {
      "$type": "state",
      "name": "output-socket",
      "selector": ":host([data-output-socket])"
    },
    {
      "$type": "state",
      "name": "collapsed",
      "selector": ":host([data-collapsed])"
    },
    {
      "$type": "state",
      "name": "not-warning",
      "selector": ":host(:not([data-warning]))"
    },
    {
      "$type": "state",
      "name": "focus-visible",
      "selector": ".header:focus-visible"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (socketRect). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "node-move",
      "description": "It moved, or was asked to: a drag on its header, or an arrow key there.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "x": "number",
        "y": "number"
      }
    },
    {
      "$type": "event",
      "name": "node-resize",
      "description": "Its resize handle was dragged, or Alt and an arrow pressed on its header.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "h": "number",
        "w": "number"
      }
    },
    {
      "$type": "event",
      "name": "node-select",
      "description": "It was pressed: a click on it, or Enter or Space on its header.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "node-open",
      "description": "Its drill-down button was pressed: open its sub-graph.",
      "bubbles": true,
      "composed": true
    }
  ],
  "tokens": {
    "root.border-width": "{sherpa.style-border-width}",
    "root.border-radius": "{sherpa.display-mode-border-rounding-base}",
    "root.color": "{sherpa.style-content-base}",
    "header.box-shadow": "{sherpa.display-mode-border-width-lg}",
    "resize.inline-size": "{sherpa.display-mode-size-sm}",
    "resize.block-size": "{sherpa.display-mode-size-sm}",
    "resize.color": "{sherpa.style-content-secondary}",
    "caption.gap": "{sherpa.theme-gap-sm}",
    "caption.padding": "{sherpa.theme-padding-xs}",
    "caption.border-width": "{sherpa.style-border-width}",
    "caption.border-start-start-radius": "{sherpa.display-mode-border-rounding-sm}",
    "caption.border-start-end-radius": "{sherpa.display-mode-border-rounding-sm}",
    "caption.color": "{sherpa.style-content-base}",
    "caption.font-family": "{sherpa.font-family-mono}",
    "caption.font-size": "{sherpa.font-size-body-xs}",
    "caption.line-height": "{sherpa.theme-content-line-height-small}",
    "socket-tab.z-index": "{sherpa.layer-content}",
    "socket-tab-in.inset-inline-start": "{sherpa.style-border-width}",
    "socket-tab-out.inset-inline-start": "{sherpa.style-border-width}",
    "body.gap": "{sherpa.theme-gap-md}",
    "body.padding-block": "{sherpa.theme-gap-md}",
    "stack-in.inset-inline-start": "{sherpa.style-border-width}",
    "stack-in.border-width": "{sherpa.style-border-width}",
    "stack-out.inset-inline-start": "{sherpa.style-border-width}",
    "stack-out.border-width": "{sherpa.style-border-width}",
    "body.--_reach": "{sherpa.style-border-width}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "socketRect",
          "args": "side: SocketSide",
          "description": "A socket's box on the screen, for a connector to join: the header's; null when it has none."
        }
      ]
    }
  }
}
