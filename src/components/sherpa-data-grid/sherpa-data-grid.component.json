  "$extensions": {
    "sherpa": {
      "figmaName": "Grid Cell",
      "methods": [
        {
          "$type": "method",
          "name": "drawLoading",
          "args": "loading: boolean",
          "description": "drawLoading(loading) — its source is reading its rows again: what a reading owes the body is drawn once, with them; done, whatever is still owed. Plan 695 P4"
        },
        {
          "$type": "method",
          "name": "drawPresent",
          "args": "present: Readonly<Record<string, readonly string[]>>",
          "description": "drawPresent(present, scope) — a bound source says what the filters before each field leave; a heading's menu greys the rest. A field not named is not limited."
        },
        {
          "$type": "method",
          "name": "drawHighlight",
          "args": "matches: ((row: GridRow) => boolean) | null",
          "description": "drawHighlight(test) — a bound source says which rows the highlight's driver matches; `null`, none. Each row CSS tints. Will, TODO 441"
        },
        {
          "$type": "method",
          "name": "drawOffered",
          "args": "offered: Readonly<Record<string, readonly string[]>>",
          "description": "drawOffered(offered) — what each serial-set field OFFERS: a heading's menu removes the rest, but keeps a pick."
        },
        {
          "$type": "method",
          "name": "setColumnFilter",
          "args": "field: string, clause: unknown[] | null",
          "description": "Set one column's filter from OUTSIDE. — SILENT unbound, and takes the clause `column-filter-change` reports; BOUND, it asks as a reader would."
        },
        {
          "$type": "method",
          "name": "supersede",
          "args": "readings: Readonly<Record<string, FieldReading>>, appliedAt?: string",
          "description": "supersede(readings, appliedAt) — the fields a HIGHER scope holds, each with the answer it holds there. A named heading SHOWS that answer, read-only, with the superseded look and tip, so no contradicting pick can be made in it; a heading not named is released. Will, 2026-09-26."
        },
        {
          "$type": "method",
          "name": "columnClause",
          "args": "field: string",
          "description": "One column's filter as a ready FilterClause, or null. — a SUSPENDED clause is returned too."
        },
        {
          "$type": "method",
          "name": "columnReading",
          "args": "field: string",
          "description": "One column's filter as a READING, or null — what a saved view set on it."
        },
        {
          "$type": "method",
          "name": "drawReading",
          "args": "field: string, reading: FieldReading",
          "description": "drawReading(field, reading) — a bound source tells this grid one column's answer, whoever set it: a chip, the panel, a restored Query. SILENT."
        },
        {
          "$type": "method",
          "name": "columnLabel",
          "args": "field: string",
          "description": "One column filter AS A READER SEES IT — \"Contains: ana\", \"Is not: churned\". `column-filter-change` carries this same string, so an interaction and a restore describe a filter identically."
        },
        {
          "$type": "method",
          "name": "suspendColumnFilter",
          "args": "field: string, suspended = true",
          "description": "Suspend or resume, never lose; bound, it asks. ."
        },
        {
          "$type": "method",
          "name": "openColumnFilter",
          "args": "field: string, anchor?: HTMLElement",
          "description": "Open one column's filter menu, anchored where the caller says. — one menu serves both."
        },
        {
          "$type": "method",
          "name": "clearColumnFilter",
          "args": "field?: string",
          "description": "Drop one column's heading filter from OUTSIDE; nothing drops them all. Unbound it is silent; bound, it asks for each it holds. ."
        },
        {
          "$type": "method",
          "name": "findStep",
          "args": "direction: 1 | -1 = 1",
          "description": "findStep(direction) — move to the next or previous MATCH, and show it. Past this page's last it asks for the next page (`page-change`) and lands on its first; before the first, the previous page's last — round from the end to the start, as a browser's own find. Answers where it is on this page: `{ index, count }`, `index` -1 while a page loads."
        },
        {
          "$type": "method",
          "name": "actionsFor",
          "args": "count: number",
          "description": "The actions for the CURRENT selection — one row: all; two or more: only `multi`. ."
        },
        {
          "$type": "method",
          "name": "neighbour",
          "args": "by: number",
          "description": "The row `by` rows from the current one, in the order drawn — or null."
        },
        {
          "$type": "method",
          "name": "stepCurrent",
          "args": "by: number",
          "description": "Move the current row `by` rows. Silent; returns the new one, or null at an end."
        },
        {
          "$type": "method",
          "name": "select",
          "args": "keys: readonly string[]",
          "description": "Select exactly these rows, by key. — REPLACES, ignores unmatched keys, and is SILENT. `select([])` clears."
        },
        {
          "$type": "method",
          "name": "clearSelection",
          "args": "",
          "description": "Select nothing. The same as `select([])`, said plainly."
        }
      ],
