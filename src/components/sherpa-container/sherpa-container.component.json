        "children": [
          {
            "slot": "loading",
            "attrs": {
              "class": "state-loading"
            },
            "children": [
              {
                "el": "sherpa-loader",
                "attrs": {
                  "data-orientation": "vertical"
                },
                "children": [
                  {
                    "el": "span",
                    "attrs": {
                      "slot": "label"
                    }
                  }
                ]
              }
            ]
          },
          {
            "slot": "empty",
            "attrs": {
              "class": "state-empty"
            },
            "children": [
              {
                "el": "sherpa-empty-state",
