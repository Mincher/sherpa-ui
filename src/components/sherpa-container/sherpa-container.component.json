      "description": "none  | sm | md | lg"
    },
    {
      "$type": "prop",
      "name": "data-error-message",
      "type": "string",
      "observed": false,
      "kind": "content",
      "description": "the error's own words, under its heading"
    },
    {
      "$type": "prop",
      "name": "data-fill",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "with data-row-span AND several body children: only the child marked data-grow takes the spare height; the rest keep their natural size. A records card is a toolbar, a filter bar, the GRID, then the pager — the grid grows, the pager stays put. Not needed for the common one-child card. Slotting empty / error shows that overlay too, via the base class reflecting data-has-{slot}; a slotted one replaces the default content."
    },
    {
      "$type": "prop",
      "name": "data-keep-content",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "a state never replaces the body: loading is a bar under the header and the body is locked; a state is a banner above it. Written by the provider. Will, TODO 59."
    },
    {
      "$type": "prop",
      "name": "data-loading",
      "type": "string",
      "observed": false,
      "kind": "style",
      "default": false,
      "description": "show the loading overlay (ratified boolean-verb state)"
    },
    {
      "$type": "prop",
      "name": "data-padding",
      "type": "enum",
      "observed": false,
      "kind": "style",
      "values": [
        "none",
        "sm",
        "base",
        "lg"
      ],
      "description": "none | sm | base  | lg"
    },
    {
      "$type": "prop",
      "name": "data-row-span",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "1–12 — a FIXED height of N layout-grid rows. The body's content fills it, so a chart draws into the whole card and a data grid scrolls inside it instead of the card growing with the data."
    },
    {
      "$type": "prop",
      "name": "data-state",
      "type": "enum",
      "observed": false,
      "kind": "visibility",
      "values": [
        "empty",
        "no-matches",
        "error"
      ],
      "description": "empty | no-matches | error — its default content, IN PLACE of the body. Written by the provider. TRAP T-a-container-shows-its-datas-state"
