                  "data-heading": "No data yet",
                  "data-description": "There is nothing here yet."
                }
              },
              {
                "el": "sherpa-empty-state",
                "class": "no-matches-default",
                "attrs": {
                  "data-illustration": "search",
                  "data-size": "sm",
                  "data-heading": "No matches"
                },
                "children": [
                  {
                    "el": "span"
                  },
