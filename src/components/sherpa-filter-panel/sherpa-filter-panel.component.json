  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "setFieldReading",
          "args": "id: string, given: FieldReading, scope?: string",
          "description": "setFieldReading(id, reading) — steer ONE field with a whole reading: what another control set while the panel shows. SILENT, like every steer, and it is that field's last Apply now, so Discard keeps it. A field drawn as one chip — Group, Sort, a date — is left alone."
        },
        {
          "$type": "method",
          "name": "drawReading",
          "args": "field: string, reading: FieldReading, scope: string",
          "description": "drawReading(field, reading, scope) — a bound source tells the panel one field's answer, in the scope that holds it. OPEN OR SHUT: a shut panel that skipped this opened on an old answer, and its next report wrote that answer back over the Query."
        },
        {
          "$type": "method",
          "name": "drawResults",
          "args": "results: Readonly<Record<string, number>>, scope?: string",
          "description": "drawResults(results, scope) — a bound source tells the panel the rows each answer in a scope matches, by field or saved-filter id. A field drawn as ONE chip, and a saved filter's chip, wear it; a field drawn as a run or a body has no one chip, so its HEADER wears it. SILENT."
        },
        {
          "$type": "method",
          "name": "drawValueResults",
          "args": "results: Readonly<Record<string, Readonly<Record<string, number>>>>, scope: string",
          "description": "drawValueResults(results, scope) — a bound source tells the panel the rows each PICKED value matches on its own, by field then value: each chip of a run wears its own count, and one that is not picked wears none. The header keeps the field's. SILENT. Will, TODO 172."
        },
        {
          "$type": "method",
          "name": "drawPresent",
          "args": "present: Readonly<Record<string, readonly string[]>>, scope: string",
          "description": "drawPresent(present, scope) — a bound source says what each field's other answers leave in a scope. A value chip they rule out is greyed — refused if off, set aside if on (180); a field's menu greys its rows. A field not named is not limited."
        },
        {
          "$type": "method",
          "name": "drawOffered",
          "args": "offered: Readonly<Record<string, readonly string[]>>, scope: string",
          "description": "drawOffered(offered, scope) — what each serial-set field OFFERS: a value chip it does not is removed, unless it is on."
        },
        {
          "$type": "method",
          "name": "show",
          "args": "",
          "description": "Show the panel. Where there is no room for it is the shell's to say."
        },
        {
          "$type": "method",
          "name": "hide",
          "args": "reason: 'reader' | 'width' | 'page' = 'reader'",
          "description": "EVERY close reports, and says why. The width path called this directly while only the header button emitted, so a narrow window left the panel gone and the host still in panel mode — no toolbars, no panel."
        },
        {
          "$type": "method",
          "name": "close",
          "args": "reason: 'reader' | 'width' | 'page' = 'reader'",
          "description": "`hide()`, in the spelling every surface keeps."
        },
        {
          "$type": "method",
          "name": "toggle",
          "args": ""
        },
        {
          "$type": "method",
          "name": "drawScopes",
          "args": "scopes: readonly ScopeDescription[]",
          "description": "The source draws each scope WHOLE — what it holds and answers, what it may add, how its rows are arranged. A saved filter is one question answered yes or no; a date is one chip, its menu a calendar."
        }
      ],
      "jsProps": [
        {
          "name": "values",
          "type": "Record<string, Record<string, string[]>>",
          "access": "read"
        },
        {
          "name": "readings",
          "type": "Record<string, Record<string, FieldReading>>",
          "access": "read"
        },
        {
          "name": "open",
          "type": "boolean",
          "access": "read-write"
        },
        {
          "name": "savedSets",
          "type": "SavedSet[]",
          "access": "read-write"
        }
      ]
    }
