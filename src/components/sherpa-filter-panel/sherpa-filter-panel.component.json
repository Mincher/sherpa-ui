{
  "$comment": "sherpa-filter-panel — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-filter-panel",
  "$description": "the CONTENT of a panel: every filter scope the page offers, a section each. Slot it in a `sherpa-overlay-panel`; the panel gives it its header, float, Pop, minimise and tab. Its own controls — the search, Suggest, the Save group, the ⋮ and the count of filters applied — are cloned into that panel's header slots, and leave with it. TRAP T-a-content-adopts-its-panels-header",
  "element": {
    "$type": "element",
    "tag": "div",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "div",
        "class": "sections",
        "part": "sections",
        "children": [
          {
            "el": "div",
            "class": "view-scope",
            "part": "view-scope"
          },
          {
            "el": "hr",
            "class": "scope-rule",
            "part": "scope-rule"
          },
          {
            "el": "sherpa-section-header",
            "class": "local-heading",
            "part": "local-heading",
            "attrs": {
              "data-heading": "Local Context",
              "data-size": "sm",
              "data-divider": "none"
            }
          },
          {
            "el": "div",
            "class": "local-scopes",
            "part": "local-scopes"
          }
        ]
      },
      {
        "el": "template",
        "class": "section-tpl",
        "children": [
          {
            "el": "sherpa-quick-filter-toolbar",
            "attrs": {
              "data-orientation": "portrait"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "header-tpl",
        "children": [
          {
            "el": "sherpa-input-text",
            "class": "find",
            "attrs": {
              "slot": "description",
              "data-icon-start": "magnifying-glass",
              "data-clearable": "",
              "placeholder": "Search filters",
              "autocomplete": "off",
              "aria-label": "Search every filter"
            }
          },
          {
            "el": "sherpa-badge",
            "class": "applied-count",
            "attrs": {
              "slot": "badge",
              "role": "img",
              "hidden": ""
            }
          },
          {
            "el": "sherpa-button",
            "class": "column-suggest",
            "attrs": {
              "slot": "actions",
              "data-size": "sm",
              "data-type": "icon",
              "data-icon-start": "wand-magic-sparkles",
              "aria-label": "Suggest filters",
              "hidden": ""
            }
          },
          {
            "el": "sherpa-group",
            "class": "saved-group",
            "attrs": {
              "slot": "actions",
              "hidden": ""
            },
            "children": [
              {
                "el": "sherpa-button",
                "class": "column-save-as",
                "attrs": {
                  "data-size": "sm",
                  "data-group": "start",
                  "data-icon-start": "filter"
                }
              },
              {
                "el": "sherpa-button",
                "class": "column-saved",
                "attrs": {
                  "data-size": "sm",
                  "data-type": "icon",
                  "data-group": "solo",
                  "data-icon-start": "filter",
                  "data-description": "Use, save and manage your saved filters.",
                  "aria-label": "Saved filters",
                  "aria-haspopup": "dialog"
                }
              }
            ]
          },
          {
            "el": "sherpa-button",
            "class": "column-more",
            "attrs": {
              "slot": "overflow",
              "data-type": "icon",
              "data-size": "sm",
              "data-icon-start": "ellipses-vertical",
              "data-description": "Reset, save and refresh these filters.",
              "aria-label": "More actions",
              "aria-haspopup": "dialog"
            }
          }
        ]
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-applied",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "how many filters are applied in what it answers"
    },
    {
      "$type": "prop",
      "name": "data-at-default",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "the filters are the View's own: Reset to view defaults and Save are inactive"
    },
    {
      "$type": "prop",
      "name": "data-count-applied",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "the title counts them"
    },
    {
      "$type": "prop",
      "name": "data-hide-unmatched",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "behaviour",
      "values": [
        "on",
        "off"
      ],
      "description": "on | off: the ⋮'s switch for Hide invalid filters"
    },
    {
      "$type": "prop",
      "name": "data-limit-options",
      "type": "enum",
      "observed": false,
      "declared": true,
      "kind": "behaviour",
      "values": [
        "on",
        "off"
      ],
      "description": "on | off: the ⋮'s switch for Limit to matching filters"
    },
    {
      "$type": "prop",
      "name": "data-no-saves",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "its provider keeps saving off it"
    },
    {
      "$type": "prop",
      "name": "data-nothing-to-reset",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "nothing is left to clear: Reset is inactive"
    },
    {
      "$type": "prop",
      "name": "data-saveable",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "the host SAVES filters: the Save group shows"
    },
    {
      "$type": "prop",
      "name": "data-scope",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "the scopes it answers, in order: `view data`. The View is a heading; the rest are accordions"
    },
    {
      "$type": "prop",
      "name": "data-suggest",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "show \"Suggest filters\""
    },
    {
      "$type": "prop",
      "name": "open",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "native": true,
      "kind": "behaviour",
      "default": false
    }
  ],
  "populate": {
    "shape": "{ applied?, atDefault?, countApplied?, hideUnmatched?, limitOptions?, noSaves?, nothingToReset?, saveable?, scope?, suggest? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "asks": {
    "shape": "scope"
  },
  "takes": [],
  "settings": {
    "data-limit-options": "limitOptions",
    "data-hide-unmatched": "hideUnmatched",
    "data-count-applied": "countApplied"
  },
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (savedSets, open). See $extensions.sherpa.jsProps."
    },
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (drawScopes, drawReading, show, hide, close, toggle). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "quick-filter-change",
      "description": "Reset, for every scope at once.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "view-reset",
      "description": "Reset to view defaults, CANCELABLE.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "ai-filter-request",
      "description": "Suggest filters.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-save",
      "description": "Save filters: the host asks for a name.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-save-as",
      "description": "The Save button.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-manage",
      "description": "Manage Saved Filters.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-apply",
      "description": "A saved set ticked.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "filters-dismiss",
      "description": "A saved set unticked.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "limit-options-change",
      "description": "The ⋮ switch.",
      "bubbles": true,
      "composed": true
    },
    {
      "$type": "event",
      "name": "hide-unmatched-change",
      "description": "The ⋮ switch.",
      "bubbles": true,
      "composed": true
    }
  ],
  "tokens": {
    "sections.padding": "{sherpa.display-mode-space-2xs}",
    "scope-rule.margin": "{sherpa.display-mode-space-base}",
    "scope-rule.border-block-start": "{sherpa.display-mode-border-width-base}",
    "local-heading.padding-inline": "{sherpa.theme-padding-lg}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "drawScopes",
          "args": "scopes: ScopeDescription[]",
          "description": "drawScopes(scopes) — a column's scopes, from its source: a portrait toolbar per scope."
        },
        {
          "$type": "method",
          "name": "drawReading",
          "args": "field: string, reading: FieldReading, scope?: string",
          "description": "A chart's own answer, told the column as a panel: its section draws it."
        },
        {
          "$type": "method",
          "name": "show",
          "args": ""
        },
        {
          "$type": "method",
          "name": "hide",
          "args": "reason: 'reader' | 'width' | 'page' = 'reader'",
          "description": "EVERY close reports, and says why: the panel's `panel-close`."
        },
        {
          "$type": "method",
          "name": "close",
          "args": "reason: 'reader' | 'width' | 'page' = 'reader'"
        },
        {
          "$type": "method",
          "name": "toggle",
          "args": ""
        }
      ],
      "jsProps": [
        {
          "name": "savedSets",
          "type": "SavedSet[]",
          "access": "read-write"
        },
        {
          "name": "open",
          "type": "boolean",
          "access": "read-write"
        }
      ]
    }
  }
