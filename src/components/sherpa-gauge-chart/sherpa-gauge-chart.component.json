{
  "$comment": "sherpa-gauge-chart — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-gauge-chart",
  "$description": "a half-circle gauge for a single value on a 0–100 scale. Each band is a closed SVG path, as sherpa-radial-chart draws a slice, so the band itself is the hover target and the hollow centre is not hittable.",
  "element": {
    "$type": "element",
    "tag": "figure",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "figure",
        "class": "chart-figure",
        "part": "figure",
        "children": [
          {
            "el": "div",
            "class": "chart-header",
            "part": "header",
            "children": [
              {
                "el": "span",
                "class": "title",
                "children": [
                  {
                    "slot": "heading",
                    "attrs": {
                      "data-accepts": "text"
                    }
                  }
                ]
              }
            ]
          },
          {
            "el": "div",
            "class": "chart-body",
            "children": [
              {
                "el": "div",
                "class": "centre",
                "children": [
                  {
                    "el": "span",
                    "class": "value",
                    "part": "value"
                  }
                ]
              },
              {
                "el": "div",
                "class": "gauge-wrap",
                "children": [
                  {
                    "el": "div",
                    "class": "gauge",
                    "part": "gauge",
                    "attrs": {
                      "role": "img",
                      "aria-label": "Gauge chart"
                    },
                    "children": [
                      {
                        "el": "svg",
                        "class": "ring",
                        "part": "ring",
                        "attrs": {
                          "viewBox": "0 0 100 50",
                          "aria-hidden": "true"
                        },
                        "children": [
                          {
                            "el": "g",
                            "class": "zones"
                          }
                        ]
                      },
                      {
                        "el": "div",
                        "class": "hub",
                        "children": [
                          {
                            "el": "div",
                            "class": "needle",
                            "part": "needle"
                          }
                        ]
                      },
                      {
                        "el": "div",
                        "class": "hub-cap",
                        "part": "hub"
                      }
                    ]
                  },
                  {
                    "el": "div",
                    "class": "hotspots",
                    "part": "hotspots"
                  }
                ]
              },
              {
                "el": "div",
                "class": "scale",
                "part": "scale",
                "children": [
                  {
                    "el": "span",
                    "class": "min"
                  },
                  {
                    "el": "figcaption",
                    "class": "caption",
                    "part": "caption",
                    "children": [
                      {
                        "el": "span",
                        "class": "caption-text"
                      },
                      {
                        "slot": "caption",
                        "attrs": {
                          "data-accepts": "content"
                        }
                      }
                    ]
                  },
                  {
                    "el": "span",
                    "class": "max"
                  }
                ]
              }
            ]
          },
          {
            "slot": "legend",
            "attrs": {
              "data-accepts": "legend"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "zone-tpl",
        "children": [
          {
            "el": "svg",
            "children": [
              {
                "el": "path",
                "class": "zone chart-segment"
              }
            ]
          }
        ]
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-aggregate",
      "type": "enum",
      "observed": true,
      "declared": true,
      "kind": "style",
      "values": [
        "count",
        "sum",
        "mean",
        "min",
        "max",
        "distinct"
      ],
      "description": "ASKED of its provider: count | sum | mean | min | max | distinct"
    },
    {
      "$type": "prop",
      "name": "data-bands",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "style"
    },
    {
      "$type": "prop",
      "name": "data-bucket",
      "type": "enum",
      "observed": true,
      "declared": true,
      "kind": "style",
      "values": [
        "day",
        "month",
        "year"
      ]
    },
    {
      "$type": "prop",
      "name": "data-caption",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "caption text shown below the arc (e.g. \"30GB of 60GB used\")"
    },
    {
      "$type": "prop",
      "name": "data-field",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "the number that aggregate reads"
    },
    {
      "$type": "prop",
      "name": "data-invert",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "it reads its value from the TOP — max − value, as risk is 100 − health — and turns its field's thresholds round. TRAP T-a-threshold-is-a-fact-of-the-field"
    },
    {
      "$type": "prop",
      "name": "data-label",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "the MIDPOINT tick above the arc. Defaults to the middle of the"
    },
    {
      "$type": "prop",
      "name": "data-legend",
      "type": "enum",
      "observed": true,
      "declared": true,
      "kind": "style",
      "values": [
        "horizontal",
        "vertical"
      ]
    },
    {
      "$type": "prop",
      "name": "data-over-field",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "style"
    },
    {
      "$type": "prop",
      "name": "data-segment-field",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "style"
    },
    {
      "$type": "prop",
      "name": "data-status",
      "type": "enum",
      "observed": false,
      "kind": "style",
      "values": [
        "critical",
        "warning",
        "success",
        "info"
      ],
      "description": "critical | warning | success | info  (single-colour fill)"
    },
    {
      "$type": "prop",
      "name": "data-unit",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "suffix for all three scale ticks, e.g. \"%\" → 0% / 50% / 100%"
    },
    {
      "$type": "prop",
      "name": "data-where",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "style"
    },
    {
      "$type": "prop",
      "name": "data-zones",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "threshold bands — \"0-50:success,50-80:warning,80-100:critical\" (compact) OR a JSON array [{to,color}|{from,to,color}]. Colours are status names (success|warning|urgent|critical|info) or any CSS colour. Left out, its provider draws its field's thresholds (TODO 150); with none, the single-colour sweep. TRAP T-a-threshold-is-a-fact-of-the-field A band may be NAMED — \"0-50:success:Low\", or `label` in the JSON — and the name is its tooltip's and its legend row's."
    },
    {
      "$type": "prop",
      "name": "max",
      "type": "number",
      "observed": true,
      "declared": true,
      "native": true,
      "kind": "content",
      "default": "0 / 100",
      "description": "scale bounds shown beneath"
    },
    {
      "$type": "prop",
      "name": "min",
      "type": "number",
      "observed": true,
      "declared": true,
      "native": true,
      "kind": "content",
      "default": "0 / 100",
      "description": "scale bounds shown beneath"
    },
    {
      "$type": "prop",
      "name": "value",
      "type": "number",
      "observed": true,
      "declared": true,
      "native": true,
      "kind": "behaviour",
      "description": "number on the scale (drives the fill sweep + needle angle)"
    }
  ],
  "slots": [
    {
      "$type": "slot",
      "name": "heading",
      "accepts": [
        "text"
      ],
      "description": "heading above the gauge"
    },
    {
      "$type": "slot",
      "name": "caption",
      "accepts": [
        "content"
      ],
      "description": "rich caption below the gauge; overrides data-caption"
    },
    {
      "$type": "slot",
      "name": "legend",
      "accepts": [
        "legend"
      ],
      "description": "a <sherpa-chart-legend> naming the zones; the gauge fills it from zones that are named."
    }
  ],
  "populate": {
    "shape": "number | { value, zones? }",
    "description": "set the value. `zones` are its field's thresholds, drawn where `data-zones` says none."
  },
  "states": [
    {
      "$type": "state",
      "name": "vertical",
      "selector": ":host([data-legend=\"vertical\"])"
    },
    {
      "$type": "state",
      "name": "caption",
      "selector": ":host([data-caption])"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (value). See $extensions.sherpa.jsProps."
    }
  ],
  "tokens": {
    "chart-body.gap": "{sherpa.theme-gap-sm}",
    "needle.inline-size": "{sherpa.display-mode-border-width-base}",
    "needle.background": "{sherpa.theme-content-body-2}",
    "hub-cap.background": "{sherpa.style-content-base}",
    "value.font-family": "{sherpa.font-family-mono}",
    "value.font-size": "{sherpa.font-size-body-xs}",
    "value.font-weight": "{sherpa.font-weight-regular}",
    "value.line-height": "{sherpa.theme-content-line-height-xs}",
    "value.color": "{sherpa.theme-content-body-1}",
    "scale.gap": "{sherpa.theme-gap-sm}",
    "scale.font-family": "{sherpa.font-family-mono}",
    "scale.font-size": "{sherpa.font-size-body-xs}",
    "scale.line-height": "{sherpa.theme-content-line-height-xs}",
    "scale.color": "{sherpa.theme-content-body-1}",
    "caption.font-size": "{sherpa.font-size-body-small}",
    "caption.line-height": "{sherpa.theme-content-line-height-small}",
    "caption.color": "{sherpa.theme-content-body-1}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Gauge Chart",
      "category": "chart",
      "jsProps": [
        {
          "name": "value",
          "type": "number",
          "access": "read-write"
        }
      ]
    }
  }
}
