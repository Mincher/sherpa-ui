{
  "$comment": "sherpa-node-list — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-node-list",
  "$description": "the nodes a graph editor may place, by category: two tabs (Preset Nodes, Custom Nodes) and a search, then one list in which each category's heading sticks while its items scroll, one item per family; a Custom Node under each of its tags. The CONTENT of a panel on a canvas: the overlay panel it sits in is the box, its header, float, dock and minimise. Drawn from populate(paletteOf(kinds)); a category with no kind is empty. Will, plan 713 M8, plan 749 P3, TODOs 769, 784, 786, 846. TRAP T-the-node-panel-asks-it-places",
  "element": {
    "$type": "element",
    "tag": "div",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "div",
        "class": "content",
        "part": "content",
        "children": [
          {
            "el": "sherpa-tabs",
            "class": "tabs",
            "part": "tabs",
            "attrs": {
              "data-current-id": "preset"
            }
          },
          {
            "el": "div",
            "class": "search",
            "part": "search",
            "children": [
              {
                "el": "sherpa-input-text",
                "class": "find",
                "part": "find",
                "attrs": {
                  "data-type": "minimal",
                  "data-icon-start": "magnifying-glass",
                  "placeholder": "Search nodes",
                  "aria-label": "Search nodes",
                  "autocomplete": "off"
                }
              }
            ]
          },
          {
            "el": "div",
            "class": "categories",
            "part": "categories"
          },
          {
            "el": "p",
            "class": "none",
            "part": "none",
            "attrs": {
              "role": "status",
              "aria-live": "polite",
              "data-word": "none"
            }
          }
        ]
      },
      {
        "el": "span",
        "class": "ghost",
        "part": "ghost",
        "attrs": {
          "aria-hidden": "true"
        }
      },
      {
        "el": "span",
        "class": "anchor",
        "attrs": {
          "aria-hidden": "true"
        }
      },
      {
        "el": "sherpa-menu",
        "class": "add",
        "attrs": {
          "data-heading": "Add a node",
          "data-search": ""
        }
      },
      {
        "el": "template",
        "class": "category-tpl",
        "children": [
          {
            "el": "div",
            "class": "category",
            "children": [
              {
                "el": "sherpa-section-header",
                "class": "category-heading",
                "attrs": {
                  "data-size": "sm",
                  "tabindex": "-1",
                  "data-attr-data-heading": "category"
                }
              },
              {
                "el": "sherpa-list",
                "class": "items",
                "attrs": {
                  "data-type": "plain"
                }
              },
              {
                "el": "p",
                "class": "empty",
                "attrs": {
                  "data-word": "empty"
                }
              }
            ]
          }
        ]
      },
      {
        "el": "template",
        "class": "tag-tpl",
        "children": [
          {
            "el": "div",
            "class": "tag",
            "children": [
              {
                "el": "sherpa-section-header",
                "class": "tag-heading",
                "attrs": {
                  "data-size": "sm",
                  "data-divider": "none",
                  "tabindex": "-1",
                  "data-attr-data-heading": "tag"
                }
              },
              {
                "el": "sherpa-list",
                "class": "items",
                "attrs": {
                  "data-type": "plain"
                }
              }
            ]
          }
        ]
      },
      {
        "el": "template",
        "class": "item-tpl",
        "children": [
          {
            "el": "sherpa-list-item",
            "attrs": {
              "data-type": "node",
              "data-interactive": "",
              "data-attr-data-category": "slug",
              "data-attr-data-kind": "id",
              "data-attr-data-label": "heading",
              "data-attr-data-description": "description",
              "data-attr-data-icon": "icon"
            }
          }
        ]
      },
      {
        "el": "template",
        "class": "choice-tpl",
        "children": [
          {
            "el": "button",
            "attrs": {
              "type": "button",
              "data-attr-value": "id",
              "data-text": "heading"
            }
          }
        ]
      }
    ]
  },
  "populate": {
    "shape": "paletteOf(kinds)",
    "description": "each category and its kinds."
  },
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (askAdd). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "node-add",
      "description": "An item was clicked, Enter was pressed on it, or it was dropped, or a choice of \"Add a node\" was picked.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "context": "AddContext",
        "kind": "string | undefined",
        "point": "{ x: number; y: number; }",
        "type": "string"
      }
    }
  ],
  "tokens": {
    "search.gap": "{sherpa.theme-gap-sm}",
    "search.padding": "{sherpa.theme-padding-md}",
    "categories.gap": "{sherpa.theme-padding-sm}",
    "categories.padding": "{sherpa.theme-padding-md}",
    "category-heading.padding-block-start": "{sherpa.theme-padding-sm}",
    "category-heading.background": "{sherpa.style-surface-base}",
    "tag-heading.padding-block-start": "{sherpa.theme-padding-sm}",
    "tag-heading.padding-inline-start": "{sherpa.theme-padding-md}",
    "empty.padding": "{sherpa.theme-padding-md}",
    "empty.color": "{sherpa.style-content-base-1}",
    "empty.font-size": "{sherpa.font-size-body-sm}",
    "none.padding": "{sherpa.theme-padding-md}",
    "none.color": "{sherpa.style-content-base-1}",
    "ghost.padding": "{sherpa.theme-padding-sm}",
    "ghost.background": "{sherpa.style-surface-base}",
    "ghost.border-width": "{sherpa.display-mode-border-width-sm}",
    "ghost.border-color": "{sherpa.style-active-border-base-1}",
    "ghost.border-radius": "{sherpa.display-mode-border-rounding-base}",
    "ghost.color": "{sherpa.style-content-base}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "askAdd",
          "args": "context: AddContext",
          "description": "Open \"Add a node\" where a line was let go: the kinds a socket of its type could join, a Value first."
        }
      ]
    }
  }
}
