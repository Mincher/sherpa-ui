{
  "$comment": "sherpa-tooltip — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-tooltip",
  "$description": "a hover/focus tooltip wrapping a trigger.",
  "element": {
