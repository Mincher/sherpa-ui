      "name": "data-panel-end-width",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "a panel area's width, in px — what a reader dragged it to, handed back by the host. The area never goes under its min or over 33% of its row."
    },
    {
      "$type": "prop",
      "name": "data-panel-start-open",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "visibility"
    },
    {
      "$type": "prop",
      "name": "data-panel-start-width",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "a panel area's width, in px — what a reader dragged it to, handed back by the host. The area never goes under its min or over 33% of its row."
    }
