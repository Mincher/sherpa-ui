  "populate": {
    "shape": "{ navState?, noHeader?, noNav?, noRoom?, panelEndOpen?, panelEndWidth?, panelStartOpen?, panelStartWidth? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "states": [
    {
      "$type": "state",
      "name": "pinned",
      "selector": ":host([data-nav-state=\"pinned\"])"
    },
    {
      "$type": "state",
      "name": "settings",
      "selector": ":host([data-nav-state=\"settings\"])"
    },
    {
      "$type": "state",
      "name": "no-nav",
      "selector": ":host([data-no-nav])"
    },
    {
      "$type": "state",
      "name": "no-header",
      "selector": ":host([data-no-header])"
    },
    {
      "$type": "state",
      "name": "focus-visible",
      "selector": ".edge:focus-visible"
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "panel-area-resize",
      "bubbles": true,
      "composed": true,
      "detail": {
        "side": "'end' | 'start'",
        "width": "number"
      }
    },
    {
      "$type": "event",
      "name": "panel-room-change",
      "bubbles": true,
      "composed": true,
      "detail": {
        "room": "boolean"
      }
    }
