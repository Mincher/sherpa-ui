        "hover",
        "default",
        "pinned",
        "settings"
      ],
      "description": "collapsed  | hover | default | pinned | settings — mirrored from the rail; drives the content inset"
    },
    {
      "$type": "prop",
      "name": "data-no-header",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "default": false,
      "description": "let the content span the full height (no header row)"
    },
    {
      "$type": "prop",
      "name": "data-no-nav",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "default": false,
      "description": "drop the nav rail; the content spans the full width"
