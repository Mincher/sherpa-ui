{
  "$comment": "sherpa-layout-canvas — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-layout-canvas",
  "$description": "an infinite canvas content area: it pans and zooms with no edge, on a crosshair grid. Will, TODO 25. TRAP T-a-canvas-owns-its-view",
  "element": {
    "$type": "element",
    "tag": "div",
    "attributes": {
      "tabindex": "0",
      "role": "group",
      "aria-roledescription": "canvas",
      "aria-label": "Canvas"
    },
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "roots": [
      {
        "el": "div",
        "class": "viewport",
        "part": "viewport",
        "attrs": {
          "tabindex": "0",
          "role": "group",
          "aria-roledescription": "canvas",
          "aria-label": "Canvas"
        },
        "children": [
          {
            "el": "div",
            "class": "plane",
            "part": "plane",
            "slot": ""
          }
        ]
      },
      {
        "el": "div",
        "class": "minimap sherpa-border-edges sherpa-border-corners",
        "part": "minimap",
        "attrs": {
          "aria-hidden": "true"
        },
        "children": [
          {
            "el": "div",
            "class": "minimap-items"
          },
          {
            "el": "span",
            "class": "minimap-view"
          },
          {
            "el": "template",
            "class": "minimap-item-tpl",
            "children": [
              {
                "el": "span",
                "class": "minimap-item"
              }
            ]
          }
        ]
      }
    ]
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-max-zoom",
      "type": "string",
      "observed": true,
      "kind": "style",
      "default": "4",
      "description": "the largest zoom"
    },
    {
      "$type": "prop",
      "name": "data-min-zoom",
      "type": "string",
      "observed": true,
      "kind": "style",
      "default": "0.25",
      "description": "the smallest zoom"
    },
    {
      "$type": "prop",
      "name": "data-no-minimap",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "no minimap"
    },
    {
      "$type": "prop",
      "name": "data-panning",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "written BY the canvas: the Pan tool is on, so a drag anywhere pans"
    },
    {
      "$type": "prop",
      "name": "data-zoom",
      "type": "string",
      "observed": true,
      "kind": "style",
      "description": "the zoom, 1 is 100%; written BY the canvas as it zooms, and read when a host sets it"
    }
  ],
  "states": [
    {
      "$type": "state",
      "name": "panning",
      "selector": ":host([data-panning])"
    },
    {
      "$type": "state",
      "name": "dragging",
      "selector": ":host([data-dragging])"
    },
    {
      "$type": "state",
      "name": "no-minimap",
      "selector": ":host([data-no-minimap])"
    },
    {
      "$type": "state",
      "name": "focus-visible",
      "selector": ".viewport:focus-visible"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (view). See $extensions.sherpa.jsProps."
    },
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (panTo, zoomTo, zoomBy, fit). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "canvas-change",
      "bubbles": true,
      "composed": true
    }
  ],
  "tokens": {
    "controls.border-radius": "{sherpa.display-mode-border-rounding-base}",
    "controls.box-shadow": "{sherpa.elevation-offset-x}",
    "minimap.background": "{sherpa.style-surface-base}",
    "minimap.border-color": "{sherpa.style-border-base}",
    "minimap-item.background": "{sherpa.style-border-base}",
    "minimap-item.border-radius": "{sherpa.display-mode-border-rounding-sm}",
    "minimap-view.border-width": "{sherpa.display-mode-border-width-lg}",
    "minimap-view.border-color": "{sherpa.style-active-border-base-1}",
    "minimap-view.border-radius": "{sherpa.display-mode-border-rounding-sm}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "panTo",
          "args": "x: number, y: number",
          "description": "Move the plane origin to (x, y) in the view, in screen px."
        },
        {
          "$type": "method",
          "name": "zoomTo",
          "args": "zoom: number, cx?: number, cy?: number",
          "description": "Zoom to `zoom`, keeping the point at (cx, cy) in the view where it is — the view's middle unless given."
        },
        {
          "$type": "method",
          "name": "zoomBy",
          "args": "factor: number",
          "description": "Zoom by a factor, about the view's middle."
        },
        {
          "$type": "method",
          "name": "fit",
          "args": "",
          "description": "Fit every piece of content in the view, no nearer than 100%."
        }
      ],
      "jsProps": [
        {
          "name": "view",
          "type": "{ x: number; y: number; zoom: number }",
          "access": "read"
        }
      ]
    }
  }
}
