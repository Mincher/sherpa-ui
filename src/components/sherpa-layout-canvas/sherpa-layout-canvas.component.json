  },
  "props": [
    {
      "$type": "prop",
      "name": "data-editing",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "an edit mode: the panels and the toolbar hide, and the footer shows along the bottom; the view, the minimap and the controls stay"
    },
    {
      "$type": "prop",
      "name": "data-max-zoom",
      "type": "number",
      "observed": false,
      "declared": true,
      "kind": "behaviour",
      "default": "4",
      "description": "the largest zoom"
    },
    {
      "$type": "prop",
      "name": "data-min-zoom",
      "type": "number",
      "observed": false,
      "declared": true,
      "kind": "behaviour",
      "default": "0.25",
      "description": "the smallest zoom ; less where the content needs it, so all of it can be in view"
    },
    {
      "$type": "prop",
      "name": "data-no-minimap",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "no minimap"
    },
    {
      "$type": "prop",
      "name": "data-panel-end-width",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour"
    },
    {
      "$type": "prop",
      "name": "data-panel-start-width",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour"
    },
    {
      "$type": "prop",
      "name": "data-select-box",
      "type": "boolean",
      "observed": true,
      "declared": true,
      "kind": "style",
      "description": "a plain left drag on blank canvas draws a box and reports it (canvas-box) instead of panning; Space + drag, the middle button and the Pan tool still pan data-panel-start-width, data-panel-end-width  a card area's width, in px: what a reader dragged its edge to, handed back by the host. Never under 16rem nor over 60% of the canvas"
    },
    {
      "$type": "prop",
      "name": "data-zoom",
      "type": "number",
      "observed": true,
      "declared": true,
      "kind": "behaviour",
      "description": "the zoom, 1 is 100%; written BY the canvas as it zooms, and read when a host sets it"
    }
  ],
  "slots": [
    {
      "$type": "slot",
      "name": "panel-start",
      "accepts": [
        "panel"
      ]
    },
    {
      "$type": "slot",
      "name": "panel-end",
      "accepts": [
        "panel"
      ]
    },
    {
      "$type": "slot",
      "name": "panel-float",
      "accepts": [
        "panel"
      ],
      "description": "the floating cards, off their areas: they float in the canvas"
    },
    {
      "$type": "slot",
      "name": "banner",
      "accepts": [
        "content"
      ],
      "description": "notices FLOATING across the top, 32px in, beside the panel: they do not pan or zoom; two shown stack, and a hidden one takes no room (a reload banner)"
    },
    {
      "$type": "slot",
      "name": "rows",
      "accepts": [
        "item"
      ],
      "description": "a strip of ROWS behind the view, the whole width: each stands at its `--y` down the plane, `--height` tall (plane px); it pans and zooms down, never across."
    },
    {
      "$type": "slot",
      "name": "columns",
      "accepts": [
        "item"
      ],
      "description": "a strip of COLUMNS over the view, from its top: each stands at its `--x` across the plane, `--width` wide (plane px, as `--x` and `--y` are); it pans and zooms across, never down."
    },
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "content"
      ],
      "description": "the content, placed on the canvas at its `--x` and `--y` (px)"
    },
    {
      "$type": "slot",
      "name": "toolbar",
      "accepts": [
        "toolbar"
      ],
      "description": "tools FLOATING at the bottom centre, 16px up (level with the zoom controls), beside the panel: they do not pan or zoom (a node toolbar)"
    },
    {
      "$type": "slot",
      "name": "footer",
      "accepts": [
        "footer"
      ],
      "description": "the edit mode's footer, along the canvas's bottom edge: shown only with `data-editing` (Save and Cancel)"
    },
    {
      "$type": "slot",
      "name": "columns-end",
      "accepts": [
        "control"
      ],
      "description": "controls at the END of the columns' head: the top right of what the view shows, clear of a panel's tabs (Add stage, Arrange stages)"
    }
  ],
  "populate": {
    "shape": "{ editing?, maxZoom?, minZoom?, noMinimap?, panelEndWidth?, panelStartWidth?, selectBox?, zoom? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "states": [
    {
      "$type": "state",
      "name": "editing",
      "selector": ":host([data-editing])"
    },
    {
      "$type": "state",
      "name": "select-box",
      "selector": ":host([data-select-box])"
    },
    {
      "$type": "state",
      "name": "no-minimap",
      "selector": ":host([data-no-minimap])"
    },
    {
      "$type": "state",
      "name": "focus-visible",
      "selector": ".viewport:focus-visible"
    }
  ],
  "capabilities": [
    {
      "$type": "capability",
      "api": "js-property-mirror",
      "description": "read/write JS properties (view). See $extensions.sherpa.jsProps."
    },
    {
      "$type": "capability",
      "api": "js-methods",
      "description": "callable from a view definition's state block (panTo, zoomTo, zoomBy, fit). See $extensions.sherpa.methods."
    }
  ],
  "events": [
    {
      "$type": "event",
      "name": "canvas-change",
      "description": "The view moved: panned or zoomed.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "x": "number",
        "y": "number",
        "zoom": "number"
      }
    },
    {
      "$type": "event",
      "name": "panel-area-resize",
      "description": "The panel's area was resized by its edge, dragged or by the keys.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "side": "'end' | 'start'",
        "width": "number"
      }
    },
    {
      "$type": "event",
      "name": "panel-dock",
      "description": "A floating card was dropped on a lit area and docked there.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "place": "'bottom' | 'only' | 'top'",
        "side": "'end' | 'start'"
      }
    },
    {
      "$type": "event",
      "name": "canvas-box",
      "description": "A box was dragged on blank canvas.",
      "bubbles": true,
      "composed": true,
      "detail": {
        "bottom": "number",
        "left": "number",
        "mode": "BoxMode",
        "right": "number",
        "top": "number"
      }
    }
  ],
  "tokens": {
    "banner.margin-inline": "{sherpa.display-mode-size-2xl}",
    "banner.z-index": "{sherpa.layer-content}",
    "banner.gap": "{sherpa.display-mode-space-xs}",
    "columns-end.inset-inline-end": "{sherpa.display-mode-space-xs}",
    "columns-end.z-index": "{sherpa.layer-content}",
    "footer.z-index": "{sherpa.layer-content}",
    "inset.box-shadow": "{sherpa.style-surface-shadow}",
    "marquee.border-width": "{sherpa.display-mode-border-width-base}",
    "marquee.border-color": "{sherpa.style-active-border-base-1}",
    "marquee.background": "{sherpa.style-active-border-base-1}",
    "controls.border-radius": "{sherpa.display-mode-border-rounding-base}",
    "controls.box-shadow": "{sherpa.elevation-offset-x}",
    "minimap.background": "{sherpa.style-surface-base}",
    "minimap.border-color": "{sherpa.style-border-base}",
    "minimap-item.background": "{sherpa.style-border-base}",
    "minimap-item.border-radius": "{sherpa.display-mode-border-rounding-sm}",
    "minimap-view.border-width": "{sherpa.display-mode-border-width-lg}",
    "minimap-view.border-color": "{sherpa.style-active-border-base-1}",
    "minimap-view.border-radius": "{sherpa.display-mode-border-rounding-sm}"
  },
  "$extensions": {
    "sherpa": {
      "methods": [
        {
          "$type": "method",
          "name": "panTo",
          "args": "x: number, y: number",
          "description": "Move the plane origin to (x, y) in the view, in screen px."
        },
        {
          "$type": "method",
          "name": "zoomTo",
          "args": "zoom: number, cx?: number, cy?: number",
          "description": "Zoom to `zoom`, keeping the point at (cx, cy) in the view where it is — the view's middle unless given."
        },
        {
          "$type": "method",
          "name": "zoomBy",
          "args": "factor: number",
          "description": "Zoom by a factor, about the middle of what the view shows."
        },
        {
          "$type": "method",
          "name": "fit",
          "args": "",
          "description": "Fit every piece of content in what the view shows, beside the card; no nearer than 100%."
        }
      ],
      "jsProps": [
        {
          "name": "view",
          "type": "{ x: number; y: number; zoom: number }",
          "access": "read"
        }
      ]
    }
  }
}
