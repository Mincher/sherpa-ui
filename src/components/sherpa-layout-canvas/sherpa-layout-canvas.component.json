                  }
                },
                {
                  "el": "sherpa-button",
                  "class": "zoom-out",
                  "attrs": {
                    "data-type": "icon",
                    "data-icon-start": "minus",
                    "aria-label": "Zoom out"
                  }
                },
                {
                  "el": "sherpa-button",
                  "class": "options",
                  "attrs": {
                    "data-type": "icon",
                    "data-icon-start": "ellipsis-horizontal",
                    "aria-label": "Canvas options",
                    "aria-haspopup": "dialog",
                    "data-description": "Fit, zoom, and show or hide the minimap."
                  },
                  "children": [
                    {
                      "el": "sherpa-menu",
                      "attrs": {
                        "slot": "menu",
                        "data-align": "end"
                      },
                      "children": [
                        {
                          "el": "button",
                          "attrs": {
                            "type": "button",
                            "value": "fit"
                          }
                        },
                        {
                          "el": "button",
                          "attrs": {
                            "type": "button",
                            "value": "actual"
