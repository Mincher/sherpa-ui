            "data-accepts": "panel"
          }
        },
        {
          "slot": "panel-end",
          "attrs": {
            "slot": "panel-end",
            "data-accepts": "panel"
          }
        },
        {
          "slot": "panel-float",
          "attrs": {
            "slot": "panel-float",
            "data-accepts": "panel"
          }
        },
        {
          "el": "div",
          "class": "banner",
          "part": "banner",
          "children": [
            {
              "slot": "banner",
              "attrs": {
                "data-accepts": "content"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "viewport",
          "part": "viewport",
          "attrs": {
            "tabindex": "0",
            "role": "group",
            "aria-roledescription": "canvas",
            "aria-label": "Canvas"
          },
          "children": [
            {
              "el": "div",
              "class": "rows",
              "part": "rows",
              "children": [
                {
                  "slot": "rows",
                  "attrs": {
                    "data-accepts": "item"
                  }
                }
              ]
            },
            {
              "el": "div",
              "class": "columns",
              "part": "columns",
              "children": [
                {
                  "slot": "columns",
                  "attrs": {
                    "data-accepts": "item"
                  }
                }
              ]
            },
            {
              "el": "div",
              "class": "plane",
              "part": "plane",
              "children": [
                {
                  "slot": "",
                  "attrs": {
                    "data-accepts": "content"
                  }
                }
              ]
            },
            {
              "el": "div",
              "class": "marquee",
              "part": "marquee",
              "attrs": {
                "aria-hidden": "true"
              }
            },
            {
              "el": "div",
              "class": "inset",
              "part": "inset",
              "attrs": {
                "aria-hidden": "true"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "toolbar",
          "part": "toolbar",
          "children": [
            {
              "slot": "toolbar",
              "attrs": {
                "data-accepts": "toolbar"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "footer",
          "part": "footer",
          "children": [
            {
              "slot": "footer",
              "attrs": {
                "data-accepts": "footer"
              }
            }
          ]
        },
        {
          "el": "div",
          "class": "stage",
          "part": "stage",
          "children": [
            {
              "el": "div",
              "class": "columns-end",
              "part": "columns-end",
              "children": [
                {
                  "slot": "columns-end",
                  "attrs": {
                    "data-accepts": "control"
                  }
                }
              ]
            },
            {
              "el": "div",
              "class": "minimap sherpa-border-edges sherpa-border-corners",
              "part": "minimap",
              "attrs": {
                "aria-hidden": "true"
              },
              "children": [
                {
                  "el": "div",
                  "class": "minimap-items"
                },
                {
                  "el": "span",
                  "class": "minimap-view"
                },
                {
                  "el": "template",
                  "class": "minimap-item-tpl",
                  "children": [
                    {
                      "el": "span",
                      "class": "minimap-item"
                    }
                  ]
                }
              ]
            },
            {
              "el": "span",
              "class": "controls sherpa-group",
              "part": "controls",
              "attrs": {
                "role": "toolbar",
                "aria-label": "Canvas"
              },
              "children": [
                {
                  "el": "sherpa-button",
                  "class": "pan",
                  "attrs": {
                    "data-type": "icon",
                    "data-icon-start": "arrows-up-down-left-right",
                    "aria-label": "Pan",
                    "aria-pressed": "false"
