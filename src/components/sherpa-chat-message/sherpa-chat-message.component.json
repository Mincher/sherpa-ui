{
  "$comment": "sherpa-chat-message — GENERATED by scripts/generate-component-spec.mjs from its .html, .css and .ts. Regenerate it, never edit it. $extensions.sherpa is kept across regen; resync-figma.mjs owns it.",
  "$schema": "../../../schemas/component.v1.json",
  "$type": "component",
  "$name": "sherpa-chat-message",
  "$description": "a single chat bubble for AI / messaging threads.",
  "element": {
    "$type": "element",
    "tag": "article",
    "provides": []
  },
  "templates": [
    "default"
  ],
  "anatomy": {
    "root": {
      "el": "article",
      "class": "message",
      "part": "message",
      "children": [
        {
          "el": "span",
          "class": "avatar sherpa-icon-box",
          "part": "avatar",
          "attrs": {
            "aria-hidden": "true"
          },
          "children": [
            {
              "slot": "avatar",
              "attrs": {
                "data-accepts": "icon"
              },
              "children": [
                {
                  "el": "span",
                  "class": "avatar-glyph"
                }
              ]
            }
          ]
        },
        {
          "el": "div",
          "class": "stack",
          "children": [
            {
              "el": "div",
              "class": "bubble",
              "part": "bubble",
              "children": [
                {
                  "el": "div",
                  "class": "meta",
                  "part": "meta",
                  "children": [
                    {
                      "el": "span",
                      "class": "author",
                      "part": "author"
                    },
                    {
                      "el": "time",
                      "class": "time",
                      "part": "time"
                    }
                  ]
                },
                {
                  "el": "span",
                  "class": "content"
                },
                {
                  "slot": "",
                  "attrs": {
                    "data-accepts": "content"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "props": [
    {
      "$type": "prop",
      "name": "data-message",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "optional text body (the default slot overrides it when slotted)"
    },
    {
      "$type": "prop",
      "name": "data-name",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "optional author name shown above the bubble"
    },
    {
      "$type": "prop",
      "name": "data-time",
      "type": "string",
      "observed": false,
      "kind": "style",
      "description": "optional timestamp shown beside the author"
    },
    {
      "$type": "prop",
      "name": "data-timestamp",
      "type": "string",
      "observed": true,
      "declared": true,
      "kind": "content",
      "description": "optional timestamp shown beside the name"
    },
    {
      "$type": "prop",
      "name": "data-type",
      "type": "enum",
      "observed": true,
      "declared": true,
      "kind": "style",
      "values": [
        "assistant",
        "system",
        "user"
      ],
      "description": "assistant  | user (right, accent) | system (centred, muted)"
    }
  ],
  "slots": [
    {
      "$type": "slot",
      "name": "avatar",
      "accepts": [
        "icon"
      ],
      "description": "custom avatar content, replaces the default glyph (reflects has-avatar)"
    },
    {
      "$type": "slot",
      "name": "",
      "accepts": [
        "content"
      ],
      "description": "bubble body content, overrides data-message"
    }
  ],
  "populate": {
    "shape": "{ message?, name?, timestamp?, type? }",
    "description": "Its declared props by name: `label` sets data-label."
  },
  "states": [
    {
      "$type": "state",
      "name": "name",
      "selector": ":host([data-name])"
    },
    {
      "$type": "state",
      "name": "timestamp",
      "selector": ":host([data-timestamp])"
    },
    {
      "$type": "state",
      "name": "user",
      "selector": ":host([data-type=\"user\"])"
    },
    {
      "$type": "state",
      "name": "assistant",
      "selector": ":host([data-type=\"assistant\"])"
    },
    {
      "$type": "state",
      "name": "system",
      "selector": ":host([data-type=\"system\"])"
    },
    {
      "$type": "state",
      "name": "not-name",
      "selector": ":host(:not([data-name]))"
    },
    {
      "$type": "state",
      "name": "not-timestamp",
      "selector": ":host(:not([data-timestamp]))"
    }
  ],
  "tokens": {
    "message.grid-template-columns": "{sherpa.theme-content-size-base}",
    "message.gap": "{sherpa.display-mode-space-xs}",
    "avatar.--_icon-size": "{sherpa.theme-content-size-base}",
    "avatar.margin-block-start": "{sherpa.display-mode-space-xs}",
    "avatar.color": "{sherpa.style-content-base}",
    "meta.gap": "{sherpa.display-mode-space-xs}",
    "meta.font-size": "{sherpa.font-size-body-small}",
    "meta.line-height": "{sherpa.theme-content-line-height-small}",
    "meta.color": "{sherpa.theme-content-body-1}",
    "author.font-weight": "{sherpa.font-weight-regular}",
    "time.font-size": "{sherpa.theme-content-size-xs}",
    "time.line-height": "{sherpa.theme-content-line-height-xs}",
    "bubble.gap": "{sherpa.display-mode-space-2xs}",
    "bubble.padding": "{sherpa.display-mode-space-xs}",
    "bubble.border-radius": "{sherpa.border-rounding-top-left}",
    "bubble.line-height": "{sherpa.theme-content-line-height-base}"
  },
  "$extensions": {
    "sherpa": {
      "figmaName": "Chat Message",
      "category": "content",
      "variantAxes": [
        {
          "name": "Type",
          "values": [
            "assistant",
            "user",
            "system"
          ]
        }
      ],
      "booleanProps": [
        "hasAvatar"
      ]
    }
  }
}
