{
  "$schema": "https://sherpa-ui.dev/schema/component-definition/v2.json",
  "generated": false,
  "name": "sherpa-list-item",
  "figmaName": "Menu List Item",
  "category": "container",
  "tier": "sub-component",
  "parentComponent": "sherpa-list",
  "description": "A single list row (atom of List / Menu / Nav): a leading region (drag handle, expand toggle, selection control, icon), a title + description, and a trailing slot.",

  "anatomy": {
    "root": {
      "el": "div",
      "class": "row",
      "part": "row",
      "figma": { "node": "COMPONENT_SET", "layout": "HORIZONTAL", "variantAxis": "State" },
      "children": [
        {
          "el": "span", "class": "lead", "part": "lead",
          "figma": { "node": "FRAME", "layout": "HORIZONTAL", "of": "leading" },
          "children": [
            { "el": "button", "class": "drag", "part": "drag", "figma": { "node": "INSTANCE", "of": "drag-handle" } },
            { "el": "button", "class": "expand", "part": "expand", "figma": { "node": "INSTANCE", "of": "Button (expand)" } },
            { "el": "span", "class": "control", "part": "control", "slot": "control", "figma": { "node": "INSTANCE", "of": "leading-control" } },
            { "el": "span", "class": "leading", "part": "leading", "slot": "leading", "figma": { "node": "INSTANCE", "of": "icon" } }
          ]
        },
        {
          "el": "span", "class": "content", "part": "content",
          "figma": { "node": "FRAME", "layout": "VERTICAL" },
          "children": [
            { "el": "span", "class": "title", "figma": { "node": "TEXT", "role": "control-content" } },
            { "el": "span", "class": "description", "figma": { "node": "TEXT", "role": "secondary" } }
          ]
        },
        { "el": "span", "class": "trailing", "part": "trailing", "slot": "trailing", "figma": { "node": "SLOT" } }
      ]
    }
  },

  "props": [
    { "name": "data-title", "type": "string", "default": null, "kind": "content", "description": "Primary text.", "figma": { "text": "label" } },
    { "name": "data-description", "type": "string", "default": null, "kind": "content", "description": "Secondary text.", "figma": { "boolean": "hasDescription", "text": "description" } },
    { "name": "data-icon", "type": "string", "default": null, "kind": "content", "description": "Leading icon glyph.", "figma": { "boolean": "hasLeadingIcon" } },
    { "name": "data-active", "type": "boolean", "default": false, "kind": "content", "description": "Active/selected visual state.", "figma": { "variantAxis": "State", "value": "active" } },
    { "name": "data-interactive", "type": "boolean", "default": false, "kind": "content", "description": "Enable hover + click behaviour (focusable).", "figma": { "variantAxis": "State", "value": "hover" } },
    { "name": "data-draggable", "type": "boolean", "default": false, "kind": "visibility", "description": "Show the drag handle.", "figma": { "boolean": "hasDragHandle" } },
    { "name": "data-expandable", "type": "boolean", "default": false, "kind": "visibility", "description": "Show the expand toggle.", "figma": { "boolean": "hasExpand" } },
    { "name": "data-expanded", "type": "boolean", "default": false, "kind": "content", "description": "Expanded state.", "figma": { "note": "expanded" } },
    { "name": "data-selectable", "type": "boolean", "default": false, "kind": "visibility", "description": "Show a leading selection control.", "figma": { "boolean": "hasLeadingControl" } },
    { "name": "data-selected", "type": "boolean", "default": false, "kind": "content", "description": "Selection state (for the leading control).", "figma": { "note": "selected" } }
  ],

  "templates": ["default"],

  "slots": [
    { "name": "leading", "accepts": ["content"], "description": "A custom icon / avatar (in addition to the data-icon glyph)." },
    { "name": "control", "accepts": ["control"], "description": "A custom selection control (else the built-in checkbox box)." },
    { "name": "trailing", "accepts": ["control", "content"], "description": "Actions / badges." }
  ],

  "parts": ["row", "lead", "drag", "expand", "control", "leading", "icon", "content", "title", "description", "trailing"],

  "nested": [],

  "events": [
    { "name": "list-item-click", "description": "The interactive row was activated (click/Enter/Space).", "bubbles": true, "composed": true, "cancelable": false, "detail": { "title": "string" }, "trigger": { "on": "click", "node": ".row" } },
    { "name": "list-item-expand", "description": "The expand toggle flipped the expanded state.", "bubbles": true, "composed": true, "cancelable": false, "detail": { "expanded": "boolean" }, "trigger": { "on": "click", "node": ".expand" } },
    { "name": "list-item-select", "description": "The leading control toggled selection.", "bubbles": true, "composed": true, "cancelable": false, "detail": { "selected": "boolean" }, "trigger": { "on": "click", "node": ".control" } },
    { "name": "list-item-drag", "description": "The drag handle received a pointerdown.", "bubbles": true, "composed": true, "cancelable": false, "detail": {}, "trigger": { "on": "pointerdown", "node": ".drag" } }
  ],

  "tokens": {
    "row.background": { "override": "status-surface", "fallback": "surface-primary-base" },
    "row.gap": "control-space-gap-base",
    "row.padding": "control-space-padding-md",
    "title.color": "control-content-default",
    "description.color": "content-secondary-base"
  },

  "figma": {
    "_status": "matched",
    "figmaName": "Menu List Item",
    "nodeType": "COMPONENT_SET",
    "built": true,
    "tier": "sub-component",
    "variantAxes": ["State"],
    "booleanProps": ["hasDescription", "hasLeadingIcon", "hasDragHandle", "hasLeadingControl", "hasLeading", "hasExpand"],
    "textProps": ["label", "description"],
    "instanceProps": ["drag-handle", "leading-control", "icon"],
    "modePins": {},
    "note": "Rebuilt 2026-08-15 to match Figma Menu List Item: added drag handle, expand toggle, leading selection control, icon glyph (all CSS-toggled) + their events + expanded/selected state. Was leading/content/trailing slots only (needs-rebuild)."
  }
}
