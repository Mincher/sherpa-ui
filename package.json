{
  "name": "sherpa-ui",
  "version": "2.1.0-beta.0",
  "description": "Sherpa UI — A standards-based Web Component library and design token system (TypeScript)",
  "type": "module",
  "main": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./css": "./css/styles/index.css",
    "./css/reset": "./css/styles/reset.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*"
    },
    "./css/*": "./css/styles/*"
  },
  "files": [
    "dist/",
    "components/**/*.ts",
    "components/**/*.html",
    "components/**/*.css",
    "css/",
    "patterns/",
    "mcp-server/",
    "docs/COMPONENT-API-STANDARD.md",
    "docs/COMPONENT-TEMPLATE.md",
    "docs/CSS-FILE-TEMPLATE.md",
    ".github/instructions/copilot-instructions.md"
  ],
  "scripts": {
    "clean": "rm -rf dist node_modules/.cache/tsbuildinfo",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:ts:watch": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc --noEmit",
    "ts:suppressions": "node scripts/count-suppressions.js",
    "ts:suppressions:write": "node scripts/count-suppressions.js --write",
    "ts:check-regression": "node scripts/check-suppression-regression.cjs",
    "assets:copy": "node scripts/copy-component-assets.js",
    "patterns": "node scripts/extract-pattern-index.js",
    "mcp": "node mcp-server/index.js",
    "tokens:extract": "node scripts/extract-figma-vars.js",
    "tokens:generate": "node scripts/generate-css-tokens.js",
    "tokens:refresh": "npm run tokens:extract && npm run tokens:generate",
    "tokens:studio": "node tools/token-studio/server.js --open",
    "tokens:codemod": "node scripts/codemod-compat-aliases.js",
    "css:fallbacks": "node scripts/inject-css-fallbacks.js",
    "css:fallbacks:check": "node scripts/inject-css-fallbacks.js --dry",
    "lint:css": "node scripts/lint-component-css.mjs",
    "lint:css:strict": "node scripts/lint-component-css.mjs --strict",
    "lint": "eslint components/**/*.ts --max-warnings 0",
    "lint:fix": "eslint components/**/*.ts --fix",
    "validate:jsdoc": "node scripts/validate-jsdoc.js",
    "format": "prettier --write 'components/**/*.css'",
    "format:check": "prettier --check 'components/**/*.css'",
    "prebuild": "npm run clean",
    "build": "npm run build:ts && npm run assets:copy && npm run tokens:generate && npm run patterns",
    "test:a11y": "node scripts/test-a11y.js",
    "test:a11y:verbose": "node scripts/test-a11y.js --verbose",
    "audit": "node scripts/audit-components.js",
    "audit:verbose": "node scripts/audit-components.js --verbose",
    "test": "npm run build:ts && web-test-runner",
    "test:watch": "npm run build:ts && web-test-runner --watch",
    "test:coverage": "npm run build:ts && web-test-runner --coverage"
  },
  "bin": {
    "sherpa-mcp": "./mcp-server/index.js"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@open-wc/testing-helpers": "^3.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@web/test-runner": "^0.20.2",
    "axe-core": "^4.11.4",
    "eslint": "^8.55.0",
    "fallow": "^2.88.3",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "pa11y": "^9.1.1",
    "prettier": "^3.1.0",
    "typescript": "^6.0.3",
    "zod": "^3.23.8"
  },
  "keywords": [
    "web-components",
    "design-system",
    "ui-library",
    "design-tokens"
  ],
  "license": "MIT"
}
