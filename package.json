{
  "name": "sherpa-ui",
  "version": "2.1.0-beta.0",
  "description": "Sherpa UI — A standards-based Web Component library and design token system (TypeScript)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mincher/sherpa-ui.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./css": "./dist/styles/tokens/tokens.css",
    "./css/page": "./dist/styles/tokens/page.css",
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./components/*": {
      "types": "./dist/components/sherpa-*/sherpa-*.d.ts",
      "default": "./dist/components/sherpa-*/sherpa-*.js"
    },
    "./css/*": "./dist/styles/*",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/app.js",
    "./dist/components.js",
    "./dist/components/**/*.js",
    "./dist/core/ui/sherpa-element.js",
    "**/*.css"
  ],
  "files": [
    "dist/",
    "schemas/",
    "src/**/*.ts",
    "src/**/*.html",
    "src/**/*.css",
    "src/components/*/*.component.json",
    "scripts/lib/generation/",
    "scripts/lib/component-to-def.mjs",
    "scripts/lib/contract-io.mjs",
    "scripts/lib/scope-rules.mjs",
    "scripts/audit-bindings.mjs",
    "scripts/figma-data/name-map.yaml",
    "docs/APP-GUIDE.md",
    "docs/DATA-SOURCE-RULES.md",
    "docs/DEF-TO-FIGMA-BUILD-RULES.md"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist",
    "build": "node scripts/build-reforged.mjs",
    "build:watch": "node scripts/build-reforged.mjs --watch",
    "build:dev": "node scripts/build-reforged.mjs --dev",
    "build:watch:ts": "tsc -p tsconfig.reforged.json --watch",
    "type-check": "tsc -p tsconfig.reforged.json --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:css:strict": "node scripts/lint-css.mjs --strict",
    "spec:validate": "node scripts/validate-component.mjs --all",
    "spec:check": "node scripts/generate-component-spec.mjs --all --check",
    "check:traps": "node scripts/check-traps.mjs",
    "check:mcp": "node scripts/check-mcp-tools.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "check:props": "node scripts/check-props.mjs",
    "check:usage": "node scripts/check-usage.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:weight": "node scripts/check-weight.mjs",
    "map": "node scripts/code-map.mjs",
    "map:write": "node scripts/code-map.mjs --write",
    "check:map": "node scripts/code-map.mjs --check",
    "check:extensions": "node scripts/check-extensions.mjs",
    "check:size": "node scripts/check-size.mjs",
    "format": "prettier --write 'src/**/*.css'",
    "format:check": "prettier --check 'src/**/*.css'",
    "mcp": "node mcp-server/index.js",
    "check:mcp-pack": "node scripts/check-mcp-pack.mjs",
    "preview": "npx --yes serve . --listen 4000 --no-clipboard",
    "prebuild": "npm run clean",
    "test": "playwright test && npm run test:node",
    "test:node": "node --test 'test/unit/**/*.test.mjs'",
    "test:a11y": "playwright test test/e2e/a11y.spec.ts --project=chromium",
    "test:a11y:update": "UPDATE_A11Y_BASELINE=1 playwright test test/e2e/a11y.spec.ts --project=chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.13.0",
    "cssnano": "^7.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.1.0",
    "typescript": "^6.0.3",
    "zod": "^3.23.8"
  },
  "keywords": [
    "web-components",
    "design-system",
    "ui-library",
    "design-tokens"
  ],
  "license": "MIT",
  "browserslist": [
    ">= 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "Safari >= 17.2"
  ]
}
