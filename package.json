{
  "name": "sherpa-ui",
  "version": "2.1.0-beta.0",
  "description": "Sherpa UI — A standards-based Web Component library and design token system (TypeScript)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/styles/tokens/tokens.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*"
    },
    "./css/*": "./dist/styles/*"
  },
  "files": [
    "dist/",
    "src/**/*.ts",
    "src/**/*.html",
    "src/**/*.css",
    "mcp-server/"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build-reforged.mjs",
    "build:watch": "tsc -p tsconfig.reforged.json --watch",
    "type-check": "tsc -p tsconfig.reforged.json --noEmit",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.css'",
    "format:check": "prettier --check 'src/**/*.css'",
    "mcp": "node mcp-server/index.js",
    "preview": "npx --yes serve . --listen 4000 --no-clipboard",
    "sandbox": "npm run build && npx --yes serve . --listen 4000 --no-clipboard",
    "prebuild": "npm run clean",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "bin": {
    "sherpa-mcp": "./mcp-server/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "prettier": "^3.1.0",
    "typescript": "^6.0.3",
    "zod": "^3.23.8"
  },
  "keywords": [
    "web-components",
    "design-system",
    "ui-library",
    "design-tokens"
  ],
  "license": "MIT"
}
