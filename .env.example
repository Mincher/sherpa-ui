# Figma personal access token — required for token extraction only.
# Scope needed: file_variables:read  (Enterprise plan required for Variables API)
# Generate at: https://www.figma.com/settings → Security → Personal access tokens
#
# Usage:
#   cp .env.example .env
#   # fill in your token below, then:
#   npm run tokens:refresh   # extract from Figma + regenerate CSS

FIGMA_ACCESS_TOKEN=
